#!/usr/bin/env python3
"""The command line half of zyt.

Link the Spoon into Hammerspoon, switch the class by hand, say what is wrong,
and turn the rows the Spoon writes into a week you can book: weekdays only,
inside the hours you set, in blocks no longer than you allow, with a break
between them, and not a minute more or less than was recorded.

Standard library only, and nothing newer than the python3 a Mac ships with.
"""

from __future__ import annotations

import argparse
import contextlib
import csv
import datetime as dt
import fcntl
import html
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "zyt" / "rules.json"
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "zyt"
SPOONS = HOME / ".hammerspoon" / "Spoons"
LOAD_LINE = 'hs.loadSpoon("Zyt"):start()'
HS_IN_APP = "/Applications/Hammerspoon.app/Contents/Frameworks/hs/hs"

# One note per chat session, kept for long enough that a session picked up the
# next morning still finds its own, and no longer: the Spoon reads the whole
# directory on every tick. A session id has to be a plain file name; anything
# else is not written rather than sanitised into somebody else's note.
SESSION_TTL = 3 * 24 * 3600
SESSION_NAME = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\Z")
# One lock for the whole directory, rather than one per session, so that there
# is a single file nobody has to decide when to delete. A merge is a read and a
# rename of a few hundred bytes; sessions waiting their turn cost nothing.
SESSION_LOCK = ".lock"

# "nobody has looked the remote up yet", as opposed to "looked, and there is
# none". Asking git costs a process, and one hook event needs the answer twice.
UNKNOWN = object()

REPORT_DEFAULTS = {
    "workdays": [1, 2, 3, 4, 5],
    "earliest": "07:00",
    "latest": "20:00",
    "maxBlockMinutes": 300,
    "breakMinutes": 30,
    "defaultStart": "08:00",
    "fillEmptyDays": False,
}
CHUNK_MINUTES = 15
# How close two recorded segments of one class have to be for the board to draw
# them as one bar. A tick that flickered between the classes and back leaves a
# run of segments seconds long each, and a lane of those is a smear.
JOIN_SECONDS = 60


# ---------------------------------------------------------------------------
# Rules


def load_rules(path=None) -> dict:
    path = path or CONFIG
    try:
        rules = json.loads(path.read_text())
    except FileNotFoundError:
        rules = {}
    except ValueError as error:
        raise SystemExit(f"{path}: the rules file is not valid JSON: {error}") from None
    if not isinstance(rules, dict):
        raise SystemExit(f"{path}: the rules file has to hold a JSON object")
    given = rules.get("report")
    if given is None:
        given = {}
    if not isinstance(given, dict):
        raise SystemExit(f"{path}: report has to be a JSON object")
    report = dict(REPORT_DEFAULTS)
    report.update(given)
    rules["report"] = report
    return rules


def minutes(clock: str) -> int:
    hours, mins = clock.split(":")
    return int(hours) * 60 + int(mins)


def clock(total: int) -> str:
    return f"{total // 60:02d}:{total % 60:02d}"


# ---------------------------------------------------------------------------
# Intervals


@dataclass
class Segment:
    start: dt.datetime
    end: dt.datetime
    cls: str

    @property
    def seconds(self) -> int:
        return int((self.end - self.start).total_seconds())


def read_intervals(path: Path) -> list:
    if not path.exists():
        return []
    segments = []
    with path.open(newline="") as handle:
        for row in csv.DictReader(handle):
            try:
                start = dt.datetime.fromisoformat(row["start"])
                end = dt.datetime.fromisoformat(row["end"])
            except (KeyError, TypeError, ValueError):
                continue
            if end > start and row.get("class") in ("work", "private"):
                segments.append(Segment(start, end, row["class"]))
    return segments


def split_by_day(segments: list) -> list:
    """Cut every segment at local midnight, so a day adds up to its own hours."""
    out = []
    for segment in segments:
        start = segment.start
        while start.date() < segment.end.date():
            midnight = dt.datetime.combine(start.date() + dt.timedelta(days=1), dt.time(), tzinfo=start.tzinfo)
            out.append(Segment(start, midnight, segment.cls))
            start = midnight
        if segment.end > start:
            out.append(Segment(start, segment.end, segment.cls))
    return out


def summarise(day_segments: list) -> dict:
    work = sorted((s for s in day_segments if s.cls == "work"), key=lambda s: s.start)
    private = sum(s.seconds for s in day_segments if s.cls == "private")
    longest_break = 0
    for earlier, later in zip(work, work[1:]):
        longest_break = max(longest_break, int((later.start - earlier.end).total_seconds()))
    return {
        "start": work[0].start if work else None,
        "end": work[-1].end if work else None,
        "work": sum(s.seconds for s in work),
        "private": private,
        "break": longest_break,
    }


def week_segments(segments: list, monday: dt.date) -> dict:
    """The seven days of that week, each with the segments recorded in it, cut at
    midnight and in order. The report adds them up; the board draws them."""
    days = {monday + dt.timedelta(days=i): [] for i in range(7)}
    for segment in split_by_day(segments):
        day = segment.start.date()
        if day in days:
            days[day].append(segment)
    for items in days.values():
        items.sort(key=lambda segment: segment.start)
    return days


def week_days(segments: list, monday: dt.date) -> dict:
    return {day: summarise(items) for day, items in week_segments(segments, monday).items()}


# ---------------------------------------------------------------------------
# The booking proposal


def capacity(report: dict) -> int:
    """The most minutes one day can hold: blocks and breaks inside the window."""
    window = minutes(report["latest"]) - minutes(report["earliest"])
    held = 0
    while window > 0:
        block = min(report["maxBlockMinutes"], window)
        held += block
        window -= block + report["breakMinutes"]
    return held


def anchor(summary: dict, report: dict) -> int:
    """Where the first block starts: the real start when it fits, rounded down
    to five minutes and kept inside the window."""
    start = summary["start"]
    if start is None:
        return minutes(report["defaultStart"])
    at = start.hour * 60 + start.minute
    at -= at % 5
    return min(max(at, minutes(report["earliest"])), minutes(report["latest"]))


def layout(start: int, total: int, report: dict) -> list:
    """Blocks of at most maxBlockMinutes with a break between, ending no later
    than `latest`; shifted earlier as a whole when they would."""
    blocks = []
    cursor, remaining = start, total
    while remaining > 0:
        block = min(report["maxBlockMinutes"], remaining)
        blocks.append([cursor, cursor + block])
        cursor += block + report["breakMinutes"]
        remaining -= block
    if blocks:
        overshoot = blocks[-1][1] - minutes(report["latest"])
        if overshoot > 0:
            blocks = [[s - overshoot, e - overshoot] for s, e in blocks]
    return blocks


def propose(days: dict, report: dict) -> tuple:
    """Redistribute the week's work onto its workdays.

    Every recorded minute is kept and none is invented. A workday keeps its own
    hours up to the day's capacity; what does not fit, and everything from the
    other days, is dealt out to the workdays with the fewest hours first. What
    still finds no room is returned as the leftover, so it is seen rather than
    lost.
    """
    cap = capacity(report)
    workdays = [day for day in sorted(days) if day.isoweekday() in report["workdays"]]
    recorded = {day: days[day]["work"] // 60 for day in days}
    booked = {day: min(recorded[day], cap) for day in workdays}
    pool = sum(recorded[day] for day in days if day not in booked)
    pool += sum(recorded[day] - booked[day] for day in workdays)
    eligible = [day for day in workdays if recorded[day] > 0 or report["fillEmptyDays"]]
    while pool > 0:
        room = [day for day in eligible if booked[day] < cap]
        if not room:
            break
        day = min(room, key=lambda d: (booked[d], d))
        added = min(CHUNK_MINUTES, pool, cap - booked[day])
        booked[day] += added
        pool -= added
    blocks = {day: layout(anchor(days[day], report), booked[day], report) for day in workdays}
    return blocks, booked, pool


# ---------------------------------------------------------------------------
# Rendering


def fmt_h(seconds: int) -> str:
    total = max(0, int(seconds)) // 60
    return f"{total // 60}h{total % 60:02d}"


def fmt_m(mins: int) -> str:
    return f"{mins // 60}h{mins % 60:02d}"


def fmt_at(moment) -> str:
    return moment.strftime("%H:%M") if moment else "  -  "


def parse_week(text: str) -> dt.date:
    year, week = text.upper().split("-W")
    return dt.date.fromisocalendar(int(year), int(week), 1)


def week_of(day: dt.date) -> str:
    year, week, _ = day.isocalendar()
    return f"{year}-W{week:02d}"


def period(when, single: bool) -> tuple:
    """The Monday to work out, and the one day asked for or None. A day is still
    worked out through its whole week: a day's booking is the week's minutes
    dealt round, and the row for the day is then taken out of that."""
    today = dt.date.today()
    # A typo in a date is a thing the person can fix, so it is said in a line
    # rather than raised as a traceback at them.
    try:
        if single:
            day = dt.date.fromisoformat(when) if when else today
            return day - dt.timedelta(days=day.weekday()), day
        monday = parse_week(when) if when else today - dt.timedelta(days=today.weekday())
    except ValueError:
        wants = "a day, YYYY-MM-DD" if single else "a week, YYYY-Www"
        raise SystemExit(f"{when}: no such date; it wants {wants}") from None
    return monday, None


def booking_of(day: dt.date, summary: dict, blocks: dict) -> str:
    if day in blocks:
        return ", ".join(f"{clock(s)}-{clock(e)}" for s, e in blocks[day]) or "-"
    return "moved to the workdays" if summary["work"] else "-"


def render_week(monday: dt.date, days: dict, blocks: dict, booked: dict, leftover, title=None) -> str:
    """The record on the left, the proposal on the right. Every figure is in
    whole minutes per day, the totals included, so the footer adds up to the
    rows above it. `leftover` is None for a single day: it belongs to the week."""
    sunday = monday + dt.timedelta(days=6)
    bookings = {day: booking_of(day, days[day], blocks) for day in days}
    width = max(len(text) for text in bookings.values()) + 2
    lines = [
        title or f"Week {week_of(monday)}  {monday:%d.%m.} to {sunday:%d.%m.%Y}",
        "",
        f"{'':11}{'recorded':<36}  {'proposal'}",
        f"{'day':<11}{'start':<7}{'end':<7}{'work':<7}{'private':<9}{'break':<6}  {'booking':<{width}}{'booked'}",
    ]
    total_work = total_private = total_booked = 0
    for day in sorted(days):
        summary = days[day]
        total_work += summary["work"] // 60
        total_private += summary["private"] // 60
        amount = "-"
        if day in blocks:
            amount = fmt_m(booked[day])
            total_booked += booked[day]
        lines.append(
            f"{day:%a %d.%m.}  {fmt_at(summary['start']):<7}{fmt_at(summary['end']):<7}"
            f"{fmt_h(summary['work']):<7}{fmt_h(summary['private']):<9}{fmt_h(summary['break']):<6}  "
            f"{bookings[day]:<{width}}{amount}"
        )
    lines.append("")
    footer = f"recorded {fmt_m(total_work)} work, {fmt_m(total_private)} private  ·  booked {fmt_m(total_booked)}"
    if leftover is not None:
        footer += f"  ·  left over {fmt_m(leftover)}"
    lines.append(footer)
    return "\n".join(lines)


def week_json(days: dict, blocks: dict, booked: dict, leftover: int) -> dict:
    return {
        "days": {
            day.isoformat(): {
                "start": summary["start"].isoformat() if summary["start"] else None,
                "end": summary["end"].isoformat() if summary["end"] else None,
                "work": summary["work"],
                "private": summary["private"],
                "break": summary["break"],
                "booking": [[clock(s), clock(e)] for s, e in blocks.get(day, [])],
                "booked": booked.get(day, 0) * 60,
            }
            for day, summary in sorted(days.items())
        },
        "leftover": leftover * 60 if leftover is not None else None,
    }


# ---------------------------------------------------------------------------
# The board

# One file, no script, nothing fetched: a board is a drawing of the week, and a
# drawing of somebody's week does not need a network (ADR 0011).
BOARD_STYLE = """
