#!/usr/bin/env python3
"""The command line half of zyt.

Link the Spoon into Hammerspoon, switch the class by hand, say what is wrong,
and turn the rows the Spoon writes into a week you can book: weekdays only,
inside the hours you set, in blocks no longer than you allow, with a break
between them, and not a minute more or less than was recorded.

Standard library only, and nothing newer than the python3 a Mac ships with.
"""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "zyt" / "rules.json"
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "zyt"
SPOONS = HOME / ".hammerspoon" / "Spoons"
LOAD_LINE = 'hs.loadSpoon("Zyt"):start()'
HS_IN_APP = "/Applications/Hammerspoon.app/Contents/Frameworks/hs/hs"

# One note per chat session, kept for long enough that a session picked up the
# next morning still finds its own, and no longer: the Spoon reads the whole
# directory on every tick. A session id has to be a plain file name; anything
# else is not written rather than sanitised into somebody else's note.
SESSION_TTL = 3 * 24 * 3600
SESSION_NAME = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\Z")

# "nobody has looked the remote up yet", as opposed to "looked, and there is
# none". Asking git costs a process, and one hook event needs the answer twice.
UNKNOWN = object()

REPORT_DEFAULTS = {
    "workdays": [1, 2, 3, 4, 5],
    "earliest": "07:00",
    "latest": "20:00",
    "maxBlockMinutes": 300,
    "breakMinutes": 30,
    "defaultStart": "08:00",
    "fillEmptyDays": False,
}
CHUNK_MINUTES = 15


# ---------------------------------------------------------------------------
# Rules


def load_rules(path=None) -> dict:
    path = path or CONFIG
    try:
        rules = json.loads(path.read_text())
    except FileNotFoundError:
        rules = {}
    except ValueError as error:
        raise SystemExit(f"{path}: the rules file is not valid JSON: {error}") from None
    if not isinstance(rules, dict):
        raise SystemExit(f"{path}: the rules file has to hold a JSON object")
    given = rules.get("report")
    if given is None:
        given = {}
    if not isinstance(given, dict):
        raise SystemExit(f"{path}: report has to be a JSON object")
    report = dict(REPORT_DEFAULTS)
    report.update(given)
    rules["report"] = report
    return rules


def minutes(clock: str) -> int:
    hours, mins = clock.split(":")
    return int(hours) * 60 + int(mins)


def clock(total: int) -> str:
    return f"{total // 60:02d}:{total % 60:02d}"


# ---------------------------------------------------------------------------
# Intervals


@dataclass
class Segment:
    start: dt.datetime
    end: dt.datetime
    cls: str

    @property
    def seconds(self) -> int:
        return int((self.end - self.start).total_seconds())


def read_intervals(path: Path) -> list:
    if not path.exists():
        return []
    segments = []
    with path.open(newline="") as handle:
        for row in csv.DictReader(handle):
            try:
                start = dt.datetime.fromisoformat(row["start"])
                end = dt.datetime.fromisoformat(row["end"])
            except (KeyError, TypeError, ValueError):
                continue
            if end > start and row.get("class") in ("work", "private"):
                segments.append(Segment(start, end, row["class"]))
    return segments


def split_by_day(segments: list) -> list:
    """Cut every segment at local midnight, so a day adds up to its own hours."""
    out = []
    for segment in segments:
        start = segment.start
        while start.date() < segment.end.date():
            midnight = dt.datetime.combine(start.date() + dt.timedelta(days=1), dt.time(), tzinfo=start.tzinfo)
            out.append(Segment(start, midnight, segment.cls))
            start = midnight
        if segment.end > start:
            out.append(Segment(start, segment.end, segment.cls))
    return out


def summarise(day_segments: list) -> dict:
    work = sorted((s for s in day_segments if s.cls == "work"), key=lambda s: s.start)
    private = sum(s.seconds for s in day_segments if s.cls == "private")
    longest_break = 0
    for earlier, later in zip(work, work[1:]):
        longest_break = max(longest_break, int((later.start - earlier.end).total_seconds()))
    return {
        "start": work[0].start if work else None,
        "end": work[-1].end if work else None,
        "work": sum(s.seconds for s in work),
        "private": private,
        "break": longest_break,
    }


def week_days(segments: list, monday: dt.date) -> dict:
    days = {monday + dt.timedelta(days=i): [] for i in range(7)}
    for segment in split_by_day(segments):
        day = segment.start.date()
        if day in days:
            days[day].append(segment)
    return {day: summarise(items) for day, items in days.items()}


# ---------------------------------------------------------------------------
# The booking proposal


def capacity(report: dict) -> int:
    """The most minutes one day can hold: blocks and breaks inside the window."""
    window = minutes(report["latest"]) - minutes(report["earliest"])
    held = 0
    while window > 0:
        block = min(report["maxBlockMinutes"], window)
        held += block
        window -= block + report["breakMinutes"]
    return held


def anchor(summary: dict, report: dict) -> int:
    """Where the first block starts: the real start when it fits, rounded down
    to five minutes and kept inside the window."""
    start = summary["start"]
    if start is None:
        return minutes(report["defaultStart"])
    at = start.hour * 60 + start.minute
    at -= at % 5
    return min(max(at, minutes(report["earliest"])), minutes(report["latest"]))


def layout(start: int, total: int, report: dict) -> list:
    """Blocks of at most maxBlockMinutes with a break between, ending no later
    than `latest`; shifted earlier as a whole when they would."""
    blocks = []
    cursor, remaining = start, total
    while remaining > 0:
        block = min(report["maxBlockMinutes"], remaining)
        blocks.append([cursor, cursor + block])
        cursor += block + report["breakMinutes"]
        remaining -= block
    if blocks:
        overshoot = blocks[-1][1] - minutes(report["latest"])
        if overshoot > 0:
            blocks = [[s - overshoot, e - overshoot] for s, e in blocks]
    return blocks


def propose(days: dict, report: dict) -> tuple:
    """Redistribute the week's work onto its workdays.

    Every recorded minute is kept and none is invented. A workday keeps its own
    hours up to the day's capacity; what does not fit, and everything from the
    other days, is dealt out to the workdays with the fewest hours first. What
    still finds no room is returned as the leftover, so it is seen rather than
    lost.
    """
    cap = capacity(report)
    workdays = [day for day in sorted(days) if day.isoweekday() in report["workdays"]]
    recorded = {day: days[day]["work"] // 60 for day in days}
    booked = {day: min(recorded[day], cap) for day in workdays}
    pool = sum(recorded[day] for day in days if day not in booked)
    pool += sum(recorded[day] - booked[day] for day in workdays)
    eligible = [day for day in workdays if recorded[day] > 0 or report["fillEmptyDays"]]
    while pool > 0:
        room = [day for day in eligible if booked[day] < cap]
        if not room:
            break
        day = min(room, key=lambda d: (booked[d], d))
        added = min(CHUNK_MINUTES, pool, cap - booked[day])
        booked[day] += added
        pool -= added
    blocks = {day: layout(anchor(days[day], report), booked[day], report) for day in workdays}
    return blocks, booked, pool


# ---------------------------------------------------------------------------
# Rendering


def fmt_h(seconds: int) -> str:
    total = max(0, int(seconds)) // 60
    return f"{total // 60}h{total % 60:02d}"


def fmt_m(mins: int) -> str:
    return f"{mins // 60}h{mins % 60:02d}"


def fmt_at(moment) -> str:
    return moment.strftime("%H:%M") if moment else "  -  "


def parse_week(text: str) -> dt.date:
    year, week = text.upper().split("-W")
    return dt.date.fromisocalendar(int(year), int(week), 1)


def week_of(day: dt.date) -> str:
    year, week, _ = day.isocalendar()
    return f"{year}-W{week:02d}"


def booking_of(day: dt.date, summary: dict, blocks: dict) -> str:
    if day in blocks:
        return ", ".join(f"{clock(s)}-{clock(e)}" for s, e in blocks[day]) or "-"
    return "moved to the workdays" if summary["work"] else "-"


def render_week(monday: dt.date, days: dict, blocks: dict, booked: dict, leftover, title=None) -> str:
    """The record on the left, the proposal on the right. Every figure is in
    whole minutes per day, the totals included, so the footer adds up to the
    rows above it. `leftover` is None for a single day: it belongs to the week."""
    sunday = monday + dt.timedelta(days=6)
    bookings = {day: booking_of(day, days[day], blocks) for day in days}
    width = max(len(text) for text in bookings.values()) + 2
    lines = [
        title or f"Week {week_of(monday)}  {monday:%d.%m.} to {sunday:%d.%m.%Y}",
        "",
        f"{'':11}{'recorded':<36}  {'proposal'}",
        f"{'day':<11}{'start':<7}{'end':<7}{'work':<7}{'private':<9}{'break':<6}  {'booking':<{width}}{'booked'}",
    ]
    total_work = total_private = total_booked = 0
    for day in sorted(days):
        summary = days[day]
        total_work += summary["work"] // 60
        total_private += summary["private"] // 60
        amount = "-"
        if day in blocks:
            amount = fmt_m(booked[day])
            total_booked += booked[day]
        lines.append(
            f"{day:%a %d.%m.}  {fmt_at(summary['start']):<7}{fmt_at(summary['end']):<7}"
            f"{fmt_h(summary['work']):<7}{fmt_h(summary['private']):<9}{fmt_h(summary['break']):<6}  "
            f"{bookings[day]:<{width}}{amount}"
        )
    lines.append("")
    footer = f"recorded {fmt_m(total_work)} work, {fmt_m(total_private)} private  ·  booked {fmt_m(total_booked)}"
    if leftover is not None:
        footer += f"  ·  left over {fmt_m(leftover)}"
    lines.append(footer)
    return "\n".join(lines)


def week_json(days: dict, blocks: dict, booked: dict, leftover: int) -> dict:
    return {
        "days": {
            day.isoformat(): {
                "start": summary["start"].isoformat() if summary["start"] else None,
                "end": summary["end"].isoformat() if summary["end"] else None,
                "work": summary["work"],
                "private": summary["private"],
                "break": summary["break"],
                "booking": [[clock(s), clock(e)] for s, e in blocks.get(day, [])],
                "booked": booked.get(day, 0) * 60,
            }
            for day, summary in sorted(days.items())
        },
        "leftover": leftover * 60 if leftover is not None else None,
    }


# ---------------------------------------------------------------------------
# Hammerspoon


def hs_binary() -> str:
    return shutil.which("hs") or HS_IN_APP


def hammerspoon_running() -> bool:
    try:
        return subprocess.run(["pgrep", "-x", "Hammerspoon"], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def hs_call(lua: str, timeout: float = 8.0):
    """Run Lua inside Hammerspoon and return its last line, or None when it is
    not running or does not answer. The running check comes first: `hs -A`
    would start Hammerspoon when it is down, and without `-A` the client stops
    in a prompt nobody sees. Neither is what a status command should do."""
    if not hammerspoon_running():
        return None
    try:
        done = subprocess.run([hs_binary(), "-A", "-c", lua], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = done.stdout.strip().splitlines()
    return lines[-1] if lines else None


def status() -> dict:
    answer = hs_call("return _G.zyt and _G.zyt:statusJSON() or 'null'")
    try:
        return json.loads(answer) if answer else None
    except ValueError:
        return None


# ---------------------------------------------------------------------------
# Commands


def brew_prefix():
    """Homebrew's opt path for zyt, which survives an upgrade; the Cellar path
    this script resolves to does not, and a symlink into it dies quietly."""
    brew = shutil.which("brew")
    if not brew:
        return None
    try:
        done = subprocess.run([brew, "--prefix", "zyt"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    prefix = Path(done.stdout.strip()) if done.returncode == 0 and done.stdout.strip() else None
    return prefix if prefix and prefix.exists() else None


def spoon_source() -> Path:
    resolved = Path(__file__).resolve()
    candidates = []
    if "/Cellar/" in str(resolved):
        prefix = brew_prefix()
        if prefix:
            candidates.append(prefix / "libexec" / "Zyt.spoon")
    candidates += [resolved.parent.parent / "Zyt.spoon", resolved.parent.parent / "libexec" / "Zyt.spoon"]
    for candidate in candidates:
        if (candidate / "init.lua").exists():
            return candidate
    raise SystemExit("cannot find Zyt.spoon next to this script")


def cmd_link(_args) -> int:
    SPOONS.mkdir(parents=True, exist_ok=True)
    target = SPOONS / "Zyt.spoon"
    source = spoon_source()
    if target.is_dir() and not target.is_symlink():
        print(f"{target} is a real directory, not a link; move it aside first", file=sys.stderr)
        return 1
    if target.is_symlink() or target.exists():
        target.unlink()
    target.symlink_to(source)
    print(f"linked {target} -> {source}")
    print()
    print("Add this to ~/.hammerspoon/init.lua and reload Hammerspoon:")
    print()
    print(f"    {LOAD_LINE}")
    print()
    if not CONFIG.exists():
        print(f"There is no rules file yet at {CONFIG}; examples/rules.json in the repository is a start.")
    return 0


def cmd_unlink(_args) -> int:
    target = SPOONS / "Zyt.spoon"
    if target.is_symlink() or target.exists():
        target.unlink()
        print(f"removed {target}")
    else:
        print(f"nothing at {target}")
    return 0


def cmd_status(_args) -> int:
    state = status()
    if not state:
        print("zyt is not running in Hammerspoon (try: zyt doctor)")
        return 1
    what = "away" if state.get("away") else f"{state['class']} since {state['since'][11:16]} ({state['source']})"
    if state.get("override"):
        what += ", pinned by hand"
    today = state.get("today") or {}
    print(f"{what}  ·  today {fmt_h(today.get('work', 0))} work, {fmt_h(today.get('private', 0))} private")
    return 0


def cmd_switch(args) -> int:
    lua = {"work": '"work"', "private": '"private"', "auto": "nil"}[args.command]
    answer = hs_call(f"return _G.zyt and _G.zyt:setOverride({lua}) or 'null'")
    if not answer or answer == "null":
        print("zyt is not running in Hammerspoon (try: zyt doctor)")
        return 1
    return cmd_status(args)


def cmd_report(args) -> int:
    rules = load_rules()
    if args.command == "day":
        day = dt.date.fromisoformat(args.when) if args.when else dt.date.today()
        monday = day - dt.timedelta(days=day.weekday())
    else:
        monday = parse_week(args.when) if args.when else dt.date.today() - dt.timedelta(days=dt.date.today().weekday())
    days = week_days(read_intervals(STATE / "intervals.csv"), monday)
    blocks, booked, leftover = propose(days, rules["report"])
    title = None
    if args.command == "day":
        days = {day: days[day]}
        leftover = None
        title = f"{day:%A %d.%m.%Y}  (week {week_of(day)})"
    if args.json:
        print(json.dumps(week_json(days, blocks, booked, leftover), indent=2))
    else:
        print(render_week(monday, days, blocks, booked, leftover, title))
    return 0


def git_remote(cwd: str):
    try:
        done = subprocess.run(
            ["git", "-C", cwd, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=2
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() or None


def write_note(path: Path, note: dict) -> dict:
    """Written whole, then renamed, so the Spoon never reads half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / (path.name + ".tmp")
    temporary.write_text(json.dumps(note))
    temporary.replace(path)
    return note


def read_note(path: Path) -> dict:
    try:
        note = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return note if isinstance(note, dict) else {}


def write_context(source: str, cwd: str, state=None, name: str = "context", session=None, remote=UNKNOWN) -> dict:
    """Leave a note for the Spoon: which directory a tool is working in, and
    which remote that belongs to."""
    state = state or STATE
    return write_note(
        (state / f"{name}.json"),
        {
            "at": int(time.time()),
            "source": source,
            "cwd": cwd,
            "remote": git_remote(cwd) if remote is UNKNOWN else remote,
            # macOS sets this for every process an application starts, so the
            # hook knows which editor or terminal is hosting the session. The
            # Spoon applies the note to that application's windows and to no
            # other's.
            "bundle": os.environ.get("__CFBundleIdentifier"),
            "session": session,
        },
    )


def prune_sessions(directory: Path, now: float) -> None:
    try:
        entries = list(directory.iterdir())
    except OSError:
        return
    for entry in entries:
        try:
            if now - entry.stat().st_mtime > SESSION_TTL:
                entry.unlink()
        except OSError:
            continue


def write_session(source: str, cwd: str, session, prompt: bool, remote=UNKNOWN, state=None):
    """One note per chat session, so that several sessions running in the same
    editor can be told apart.

    The note remembers the last repository this session actually touched. A
    session started in a folder full of checkouts resolves to nothing by its
    working directory, and a prompt carries no file to go on, so without that
    memory the chat the person is typing into would be the one thing about them
    nobody knows. `promptAt` is when they last talked to it; a session that has
    only ever worked is no chat and the Spoon skips it."""
    state = state or STATE
    if not isinstance(session, str) or not SESSION_NAME.match(session):
        return None
    directory = state / "sessions"
    path = directory / f"{session}.json"
    before = read_note(path)
    now = int(time.time())
    note = write_note(
        path,
        {
            "at": now,
            "promptAt": now if prompt else before.get("promptAt"),
            "source": source,
            "cwd": cwd,
            "remote": (git_remote(cwd) if remote is UNKNOWN else remote) or before.get("remote"),
            "bundle": os.environ.get("__CFBundleIdentifier") or before.get("bundle"),
            "session": session,
        },
    )
    prune_sessions(directory, now)
    return note


def hook_directory(payload) -> str:
    """The directory a hook event is about: the file the tool touched when
    there is one, since a session started in a folder full of checkouts says
    nothing by its working directory alone; otherwise that working directory."""
    if not isinstance(payload, dict):
        return os.getcwd()
    tool_input = payload.get("tool_input")
    if isinstance(tool_input, dict):
        for key in ("file_path", "notebook_path"):
            path = tool_input.get(key)
            if isinstance(path, str) and path:
                where = Path(path)
                if not where.is_dir():
                    where = where.parent
                while not where.exists() and where != where.parent:
                    where = where.parent
                return str(where)
    return payload.get("cwd") or os.getcwd()


def cmd_hook(args) -> int:
    """For Claude Code: `zyt hook claude-code` on UserPromptSubmit and
    PostToolUse. Reads the hook's JSON, writes the note, says nothing: anything
    printed here would be handed to the model as context."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    where = hook_directory(payload)
    session = payload.get("session_id") if isinstance(payload, dict) else None
    prompt = isinstance(payload, dict) and payload.get("hook_event_name") == "UserPromptSubmit"
    remote = git_remote(where)
    # The session's own note knows more than this one event does: the remote it
    # last touched, even when the event itself is a prompt in a folder that is
    # no checkout.
    note = write_session(args.tool, where, session, prompt, remote=remote)
    if note:
        remote = note["remote"]
    write_context(args.tool, where, session=session, remote=remote)
    # A prompt is the person talking to this chat. Several sessions can be
    # working at once, and only one of them is the one being typed into; the
    # Spoon uses this second note to classify the editor's window.
    if prompt:
        write_context(args.tool, where, name="chat", session=session, remote=remote)
    return 0


def cmd_context(args) -> int:
    note = write_context(args.source, str(Path(args.cwd).resolve()))
    print(json.dumps(note))
    return 0


def cmd_doctor(_args) -> int:
    failed = False

    def say(ok, text):
        nonlocal failed
        failed = failed or ok is False
        mark = {True: " ok ", False: "FAIL", None: "warn"}[ok]
        print(f"[{mark}] {text}")

    say(Path("/Applications/Hammerspoon.app").exists(), "Hammerspoon is installed")
    running = hammerspoon_running()
    say(running, "Hammerspoon is running" if running else "Hammerspoon is not running")
    up = running and hs_call("return 'up'") == "up"
    if running:
        say(up, "Hammerspoon answers over ipc" if up else "Hammerspoon does not answer over ipc (is hs.ipc loaded?)")
    if up:
        say(
            hs_call("return tostring(hs.accessibilityState())") == "true",
            "Hammerspoon has Accessibility (window titles need it)",
        )
        spoon_up = hs_call("return tostring(_G.zyt and _G.zyt.running)") == "true"
        say(
            spoon_up, "the Spoon is running" if spoon_up else f"the Spoon is not running: is `{LOAD_LINE}` in init.lua?"
        )
        if spoon_up:
            age = hs_call("return tostring(_G.zyt.state.open and (os.time() - _G.zyt.state.open.lastSeen) or 'closed')")
            if age is None or not age.lstrip("-").isdigit() and age != "closed":
                say(False, f"could not read the last tick from the Spoon: {age}")
            elif age == "closed":
                say(None, "no segment is open right now (away, or the rules see nothing)")
            else:
                say(int(age) < 120, f"the last tick was {age}s ago")
            frame = hs_call("local m = _G.zyt.menubar; if not m then return 'none' end return tostring(m:frame().x)")
            if frame not in (None, "none") and float(frame) < 0:
                say(None, "the menu-bar item is parked off-screen, probably by a menu bar manager")
    link = SPOONS / "Zyt.spoon"
    say(link.exists(), f"{link} exists" if link.exists() else f"{link} is missing (zyt link)")
    try:
        rules = load_rules()
        say(True, f"rules file read: {CONFIG}" if CONFIG.exists() else f"no rules file at {CONFIG}, defaults apply")
        say(capacity(rules["report"]) > 0, f"a workday can hold {fmt_m(capacity(rules['report']))}")
    except (ValueError, SystemExit) as error:
        say(False, f"rules file: {error}")
    rows = read_intervals(STATE / "intervals.csv")
    say(
        True,
        f"{len(rows)} rows in {STATE / 'intervals.csv'}"
        + (f", last ended {rows[-1].end:%d.%m. %H:%M}" if rows else ""),
    )
    return 1 if failed else 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="zyt", description=__doc__.split("\n\n")[1])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("link", help="symlink the Spoon into ~/.hammerspoon/Spoons").set_defaults(run=cmd_link)
    sub.add_parser("unlink", help="remove that symlink").set_defaults(run=cmd_unlink)
    sub.add_parser("status", help="what is running now").set_defaults(run=cmd_status)
    for name in ("work", "private", "auto"):
        sub.add_parser(
            name, help=f"pin the class to {name}" if name != "auto" else "let the rules decide"
        ).set_defaults(run=cmd_switch)
    for name, when in (("day", "YYYY-MM-DD"), ("week", "YYYY-Www")):
        report = sub.add_parser(name, help=f"the recorded {name} and its booking proposal")
        report.add_argument("when", nargs="?", metavar=when)
        report.add_argument("--json", action="store_true")
        report.set_defaults(run=cmd_report)
    hook = sub.add_parser("hook", help="stdin hook for a coding tool (Claude Code)")
    hook.add_argument("tool", choices=["claude-code"])
    hook.set_defaults(run=cmd_hook)
    context = sub.add_parser("context", help="note which directory a tool is working in")
    context.add_argument("source")
    context.add_argument("cwd", nargs="?", default=".")
    context.set_defaults(run=cmd_context)
    sub.add_parser("doctor", help="check the installation").set_defaults(run=cmd_doctor)
    args = parser.parse_args(argv)
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
