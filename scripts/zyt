def span_of(segment: Segment) -> tuple:
    """A segment as minutes from the midnight of the day it starts in. One that
    was cut at midnight ends at 1440 here, rather than back at nothing."""
    midnight = dt.datetime.combine(segment.start.date(), dt.time(), tzinfo=segment.start.tzinfo)
    return (segment.start - midnight).total_seconds() / 60, (segment.end - midnight).total_seconds() / 60


def scale(segments: dict, blocks: dict, report: dict) -> tuple:
    """The first and last whole hour on show: the hours that may be booked,
    widened around anything recorded or proposed outside them. An evening on the
    laptop is drawn where it happened rather than clipped off the end."""
    first, last = minutes(report["earliest"]) // 60, -(-minutes(report["latest"]) // 60)
    edges = [span_of(segment) for items in segments.values() for segment in items]
    edges += [(start, end) for items in blocks.values() for start, end in items]
    for start, end in edges:
        first = min(first, int(start // 60))
        last = max(last, int(-(-end // 60)))
    return first, max(last, first + 1)


def joined(segments: list) -> list:
    """The same hours, in as few bars as tell the truth: a run of segments of one
    class with no real gap between them becomes one. Nothing is added up
    differently, and where the class actually changed it still changes."""
    out = []
    for segment in segments:
        last = out[-1] if out else None
        if last and last.cls == segment.cls and (segment.start - last.end).total_seconds() <= JOIN_SECONDS:
            last.end = max(last.end, segment.end)
        else:
            out.append(Segment(segment.start, segment.end, segment.cls))
    return out


def said(segment: Segment) -> str:
    """What a bar says when it is hovered. A segment with no whole minute in it says
    its seconds: a sliver that claimed to have taken 0h00 would be a lie about the
    one thing it is there to report."""
    if segment.seconds < 60:
        return f"{segment.cls} {segment.start:%H:%M:%S}, {segment.seconds}s"
    return f"{segment.cls} {segment.start:%H:%M} to {segment.end:%H:%M}, {fmt_h(segment.seconds)}"


def bars(spans: list, first: int, total: int) -> str:
    """One positioned bar per span, as a percentage of the hours on show. The
    title is what a bar says when it is too narrow to say anything itself."""
    out = []
    for start, end, kind, label in spans:
        left = (start - first * 60) / total * 100
        width = (end - start) / total * 100
        out.append(
            f'<span class="{kind}" style="left:{left:.4f}%;width:{width:.4f}%" title="{html.escape(label)}"></span>'
        )
    return "".join(out)


def render_board(days, segments, blocks, booked, leftover, report, heading, sub) -> str:
    """The week as one page: per day the hours recorded on the upper lane and the
    proposal on the lower one, both on the same hour scale, so that what would be
    booked can be held against what happened."""
    first, last = scale(segments, blocks, report)
    total = (last - first) * 60
    # Every hour is named while the names still have room; a day that reaches
    # from before dawn to after midnight gets every second one instead.
    step = 1 if last - first <= 18 else 2
    ticks = "".join(
        f'<span style="left:{(hour - first) * 60 / total * 100:.4f}%">{hour:02d}</span>'
        for hour in range(first, last + 1, step)
    )
    rows = [f'<div class="row axis"><div></div><div class="track">{ticks}</div><div></div></div>']
    work = private = filled = 0
    for day in sorted(days):
        summary = days[day]
        work += summary["work"] // 60
        private += summary["private"] // 60
        recorded = [(*span_of(segment), segment.cls, said(segment)) for segment in joined(segments.get(day, []))]
        proposed = [
            (start, end, "book", f"book {clock(start)} to {clock(end)}, {fmt_m(end - start)}")
            for start, end in blocks.get(day, [])
        ]
        figures = f"<b>{fmt_h(summary['work'])}</b>"
        if summary["private"]:
            figures += f"<span>{fmt_h(summary['private'])} private</span>"
        if day in blocks:
            filled += booked[day]
            booking = " · ".join(f"{clock(start)}–{clock(end)}" for start, end in blocks[day]) or "nothing to book"
        else:
            booking = "moved to the workdays" if summary["work"] else "not a workday"
        rows.append(
            f'<div class="row"><div class="day"><b>{day:%a}</b> {day:%d.%m.}</div>'
            f'<div class="track"><div class="lane">{bars(recorded, first, total)}</div>'
            f'<div class="lane">{bars(proposed, first, total)}</div></div>'
            f'<div class="figures">{figures}<span class="booking">{html.escape(booking)}</span></div></div>'
        )
    totals = [(fmt_m(work), "recorded work"), (fmt_m(private), "private"), (fmt_m(filled), "booked")]
    if leftover is not None:
        totals.append((fmt_m(leftover), "left over"))
    keys = [("work", "recorded work"), ("private", "private"), ("book", "proposed booking")]
    source = str(STATE / "intervals.csv").replace(str(HOME), "~", 1)
    made = f"written {dt.datetime.now():%d.%m.%Y %H:%M} from {source} · one file, no script, nothing fetched"
    return "\n".join(
        [
            "<!doctype html>",
            '<html lang="en">',
            "<head>",
            '<meta charset="utf-8">',
            '<meta name="viewport" content="width=device-width, initial-scale=1">',
            f"<title>zyt · {html.escape(heading)}</title>",
            f"<style>{BOARD_STYLE}</style>",
            "</head>",
            "<body>",
            "<main>",
            f"<h1>{html.escape(heading)}</h1>",
            f'<p class="sub">{html.escape(sub)}</p>',
            '<ul class="totals">'
            + "".join(f"<li><b>{amount}</b>{html.escape(what)}</li>" for amount, what in totals)
            + "</ul>",
            f'<section class="chart" style="--hour:{100 / (last - first):.4f}%">' + "".join(rows) + "</section>",
            "<footer>"
            + "".join(f'<span class="key"><i class="{kind}"></i>{html.escape(what)}</span>' for kind, what in keys)
            + f'<span class="made">{html.escape(made)}</span></footer>',
            "</main>",
            "</body>",
            "</html>",
            "",
        ]
    )


# ---------------------------------------------------------------------------
# Hammerspoon


def hs_binary() -> str:
    return shutil.which("hs") or HS_IN_APP


def hammerspoon_running() -> bool:
    try:
        return subprocess.run(["pgrep", "-x", "Hammerspoon"], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def hs_call(lua: str, timeout: float = 8.0):
    """Run Lua inside Hammerspoon and return its last line, or None when it is
    not running or does not answer. The running check comes first: `hs -A`
    would start Hammerspoon when it is down, and without `-A` the client stops
    in a prompt nobody sees. Neither is what a status command should do."""
    if not hammerspoon_running():
        return None
    try:
        done = subprocess.run([hs_binary(), "-A", "-c", lua], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = done.stdout.strip().splitlines()
    return lines[-1] if lines else None


def status() -> dict:
    answer = hs_call("return _G.zyt and _G.zyt:statusJSON() or 'null'")
    try:
        return json.loads(answer) if answer else None
    except ValueError:
        return None


# ---------------------------------------------------------------------------
# Commands


def brew_prefix():
    """Homebrew's opt path for zyt, which survives an upgrade; the Cellar path
    this script resolves to does not, and a symlink into it dies quietly."""
    brew = shutil.which("brew")
    if not brew:
        return None
    try:
        done = subprocess.run([brew, "--prefix", "zyt"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    prefix = Path(done.stdout.strip()) if done.returncode == 0 and done.stdout.strip() else None
    return prefix if prefix and prefix.exists() else None


def spoon_source() -> Path:
    resolved = Path(__file__).resolve()
    candidates = []
    if "/Cellar/" in str(resolved):
        prefix = brew_prefix()
        if prefix:
            candidates.append(prefix / "libexec" / "Zyt.spoon")
    candidates += [resolved.parent.parent / "Zyt.spoon", resolved.parent.parent / "libexec" / "Zyt.spoon"]
    for candidate in candidates:
        if (candidate / "init.lua").exists():
            return candidate
    raise SystemExit("cannot find Zyt.spoon next to this script")


def cmd_link(_args) -> int:
    SPOONS.mkdir(parents=True, exist_ok=True)
    target = SPOONS / "Zyt.spoon"
    source = spoon_source()
    if target.is_dir() and not target.is_symlink():
        print(f"{target} is a real directory, not a link; move it aside first", file=sys.stderr)
        return 1
    if target.is_symlink() or target.exists():
        target.unlink()
    target.symlink_to(source)
    print(f"linked {target} -> {source}")
    print()
    print("Add this to ~/.hammerspoon/init.lua and reload Hammerspoon:")
    print()
    print(f"    {LOAD_LINE}")
    print()
    if not CONFIG.exists():
        print(f"There is no rules file yet at {CONFIG}; examples/rules.json in the repository is a start.")
    return 0


def cmd_unlink(_args) -> int:
    target = SPOONS / "Zyt.spoon"
    if target.is_symlink() or target.exists():
        target.unlink()
        print(f"removed {target}")
    else:
        print(f"nothing at {target}")
    return 0


def cmd_status(_args) -> int:
    state = status()
    if not state:
        print("zyt is not running in Hammerspoon (try: zyt doctor)")
        return 1
    what = "away" if state.get("away") else f"{state['class']} since {state['since'][11:16]} ({state['source']})"
    if state.get("override"):
        what += ", pinned by hand"
    today = state.get("today") or {}
    print(f"{what}  ·  today {fmt_h(today.get('work', 0))} work, {fmt_h(today.get('private', 0))} private")
    return 0


def cmd_switch(args) -> int:
    lua = {"work": '"work"', "private": '"private"', "auto": "nil"}[args.command]
    answer = hs_call(f"return _G.zyt and _G.zyt:setOverride({lua}) or 'null'")
    if not answer or answer == "null":
        print("zyt is not running in Hammerspoon (try: zyt doctor)")
        return 1
    return cmd_status(args)


def cmd_report(args) -> int:
    rules = load_rules()
    monday, day = period(args.when, args.command == "day")
    days = week_days(read_intervals(STATE / "intervals.csv"), monday)
    blocks, booked, leftover = propose(days, rules["report"])
    title = None
    if day:
        days = {day: days[day]}
        leftover = None
        title = f"{day:%A %d.%m.%Y}  (week {week_of(day)})"
    if args.json:
        print(json.dumps(week_json(days, blocks, booked, leftover), indent=2))
    else:
        print(render_week(monday, days, blocks, booked, leftover, title))
    return 0


def cmd_board(args) -> int:
    """The week the report prints, drawn instead of tabulated, and opened."""
    rules = load_rules()
    single = bool(args.when) and "-W" not in args.when.upper()
    monday, day = period(args.when, single)
    segments = week_segments(read_intervals(STATE / "intervals.csv"), monday)
    days = {each: summarise(items) for each, items in segments.items()}
    blocks, booked, leftover = propose(days, rules["report"])
    if day:
        segments, days, leftover = {day: segments[day]}, {day: days[day]}, None
        heading, sub = f"{day:%A %d.%m.%Y}", f"week {week_of(day)}"
    else:
        heading = f"Week {week_of(monday)}"
        sub = f"{monday:%A %d.%m.} to {monday + dt.timedelta(days=6):%A %d.%m.%Y}"
    page = render_board(days, segments, blocks, booked, leftover, rules["report"], heading, sub)
    out = Path(args.out).expanduser() if args.out else STATE / "board.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(page)
    print(out)
    if not args.no_open:
        try:
            subprocess.run(["open", str(out)], timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            print("could not open it; the line above is where it is", file=sys.stderr)
    return 0


def git_remote(cwd: str):
    try:
        done = subprocess.run(
            ["git", "-C", cwd, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=2
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() or None


def write_note(path: Path, note: dict) -> dict:
    """Written whole, then renamed, so the Spoon never reads half a file. The
    temporary carries the writer's process id: hooks run concurrently, and two
    of them sharing one temporary would have the first one renamed away under
    the second, which then loses its note to an error."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / f"{path.name}.{os.getpid()}.tmp"
    temporary.write_text(json.dumps(note))
    temporary.replace(path)
    return note


@contextlib.contextmanager
def locked(path: Path):
    """One session's hooks can land at once: a prompt while a task the model
    left running in the background reports a tool it used. Both would read the
    note, both would write it back, and the later one would erase what the other
    had just learnt. The lock is a file of its own, so the note itself stays one
    atomic rename and the Spoon never has to take a lock to read it. It is never
    deleted: a lock nobody can unlink from under a holder is one less race."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = os.open(str(path), os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield
    finally:
        os.close(handle)  # which releases the lock


def read_note(path: Path) -> dict:
    try:
        note = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return note if isinstance(note, dict) else {}


def write_context(
    source: str, cwd: str, state=None, name: str = "context", session=None, remote=UNKNOWN, at=None
) -> dict:
    """Leave a note for the Spoon: which directory a tool is working in, and
    which remote that belongs to."""
    state = state or STATE
    return write_note(
        (state / f"{name}.json"),
        {
            "at": int(time.time()) if at is None else at,
            "source": source,
            "cwd": cwd,
            "remote": git_remote(cwd) if remote is UNKNOWN else remote,
            # macOS sets this for every process an application starts, so the
            # hook knows which editor or terminal is hosting the session. The
            # Spoon applies the note to that application's windows and to no
            # other's.
            "bundle": os.environ.get("__CFBundleIdentifier"),
            "session": session,
        },
    )


def prune_sessions(directory: Path, now: float) -> None:
    try:
        entries = list(directory.iterdir())
    except OSError:
        return
    for entry in entries:
        # The lock stays. It is empty, there is one of it, and unlinking a lock
        # while a hook holds it would let the next two merges run at once: the
        # one holding the gone inode and the one that made a fresh file.
        if entry.name == SESSION_LOCK:
            continue
        try:
            if now - entry.stat().st_mtime > SESSION_TTL:
                entry.unlink()
        except OSError:
            continue


def write_session(source: str, cwd: str, session, prompt: bool, remote=UNKNOWN, state=None, at=None):
    """One note per chat session, so that several sessions running in the same
    editor can be told apart.

    The note remembers the last repository this session actually touched. A
    session started in a folder full of checkouts resolves to nothing by its
    working directory, and a prompt carries no file to go on, so without that
    memory the chat the person is typing into would be the one thing about them
    nobody knows. `promptAt` is when they last talked to it; a session that has
    only ever worked is no chat and the Spoon skips it."""
    state = state or STATE
    if not isinstance(session, str) or not SESSION_NAME.match(session):
        return None
    directory = state / "sessions"
    path = directory / f"{session}.json"
    # The whole second is what the Spoon reads and what everything is dated by.
    # Two hooks of one session can fall in the same second, though, and then the
    # second cannot say which of them happened first: `order` is the same moment
    # to the microsecond, and nothing but the merge below looks at it.
    moment = time.time() if at is None else float(at)
    now = int(moment)
    # Asked before the lock is taken. Git can sit out its whole timeout, and no
    # other session's merge should have to wait behind that.
    found = git_remote(cwd) if remote is UNKNOWN else remote
    with locked(directory / SESSION_LOCK):
        before = read_note(path)
        # Hooks reach the lock in whatever order the machine felt like, and one
        # that waited on git can arrive behind a later event of its own session.
        # So the merge decides and not the arrival: where the session is comes
        # from the newest event to have written, an older one only fills in what
        # the note does not say yet, and no timestamp goes backwards. A note
        # written before there was an `order` is dated by its second.
        sequence = before.get("order") or before.get("at") or 0
        newer = moment >= sequence
        remembered = before.get("remote")
        note = write_note(
            path,
            {
                "at": max(now, before.get("at") or 0),
                "order": max(moment, sequence),
                "promptAt": max(now if prompt else 0, before.get("promptAt") or 0) or None,
                "source": source if newer else before.get("source"),
                "cwd": cwd if newer else before.get("cwd"),
                "remote": (found or remembered) if newer else (remembered or found),
                "bundle": os.environ.get("__CFBundleIdentifier") or before.get("bundle"),
                "session": session,
            },
        )
        # Under the same lock: a note this hook found stale can be written again
        # by the session that owns it while the prune is still walking, and
        # deleting it then would lose a live chat until it was next spoken to.
        prune_sessions(directory, now)
    return note


def hook_directory(payload) -> str:
    """The directory a hook event is about: the file the tool touched when
    there is one, since a session started in a folder full of checkouts says
    nothing by its working directory alone; otherwise that working directory."""
    if not isinstance(payload, dict):
        return os.getcwd()
    tool_input = payload.get("tool_input")
    if isinstance(tool_input, dict):
        for key in ("file_path", "notebook_path"):
            path = tool_input.get(key)
            if isinstance(path, str) and path:
                where = Path(path)
                if not where.is_dir():
                    where = where.parent
                while not where.exists() and where != where.parent:
                    where = where.parent
                return str(where)
    return payload.get("cwd") or os.getcwd()


def cmd_hook(args) -> int:
    """For Claude Code: `zyt hook claude-code` on UserPromptSubmit and
    PostToolUse. Reads the hook's JSON, writes the note, says nothing: anything
    printed here would be handed to the model as context."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    where = hook_directory(payload)
    session = payload.get("session_id") if isinstance(payload, dict) else None
    prompt = isinstance(payload, dict) and payload.get("hook_event_name") == "UserPromptSubmit"
    remote = git_remote(where)
    # One event, one timestamp, however long the git call takes: the Spoon tells
    # the notes of the same prompt apart from an older chat's by comparing them.
    at = int(time.time())
    # The session's own note knows more than this one event does: the remote it
    # last touched, even when the event itself is a prompt in a folder that is
    # no checkout.
    note = write_session(args.tool, where, session, prompt, remote=remote, at=at)
    if note:
        remote = note["remote"]
    write_context(args.tool, where, session=session, remote=remote, at=at)
    # A prompt is the person talking to this chat. Several sessions can be
    # working at once, and only one of them is the one being typed into; the
    # Spoon uses this second note to classify the editor's window.
    if prompt:
        write_context(args.tool, where, name="chat", session=session, remote=remote, at=at)
    return 0


def cmd_context(args) -> int:
    note = write_context(args.source, str(Path(args.cwd).resolve()))
    print(json.dumps(note))
    return 0


def cmd_doctor(_args) -> int:
    failed = False

    def say(ok, text):
        nonlocal failed
        failed = failed or ok is False
        mark = {True: " ok ", False: "FAIL", None: "warn"}[ok]
        print(f"[{mark}] {text}")

    say(Path("/Applications/Hammerspoon.app").exists(), "Hammerspoon is installed")
    running = hammerspoon_running()
    say(running, "Hammerspoon is running" if running else "Hammerspoon is not running")
    up = running and hs_call("return 'up'") == "up"
    if running:
        say(up, "Hammerspoon answers over ipc" if up else "Hammerspoon does not answer over ipc (is hs.ipc loaded?)")
    if up:
        say(
            hs_call("return tostring(hs.accessibilityState())") == "true",
            "Hammerspoon has Accessibility (window titles need it)",
        )
        spoon_up = hs_call("return tostring(_G.zyt and _G.zyt.running)") == "true"
        say(
            spoon_up, "the Spoon is running" if spoon_up else f"the Spoon is not running: is `{LOAD_LINE}` in init.lua?"
        )
        if spoon_up:
            age = hs_call("return tostring(_G.zyt.state.open and (os.time() - _G.zyt.state.open.lastSeen) or 'closed')")
            if age is None or not age.lstrip("-").isdigit() and age != "closed":
                say(False, f"could not read the last tick from the Spoon: {age}")
            elif age == "closed":
                say(None, "no segment is open right now (away, or the rules see nothing)")
            else:
                say(int(age) < 120, f"the last tick was {age}s ago")
            frame = hs_call("local m = _G.zyt.menubar; if not m then return 'none' end return tostring(m:frame().x)")
            if frame not in (None, "none") and float(frame) < 0:
                say(None, "the menu-bar item is parked off-screen, probably by a menu bar manager")
    link = SPOONS / "Zyt.spoon"
    say(link.exists(), f"{link} exists" if link.exists() else f"{link} is missing (zyt link)")
    try:
        rules = load_rules()
        say(True, f"rules file read: {CONFIG}" if CONFIG.exists() else f"no rules file at {CONFIG}, defaults apply")
        say(capacity(rules["report"]) > 0, f"a workday can hold {fmt_m(capacity(rules['report']))}")
    except (ValueError, SystemExit) as error:
        say(False, f"rules file: {error}")
    rows = read_intervals(STATE / "intervals.csv")
    say(
        True,
        f"{len(rows)} rows in {STATE / 'intervals.csv'}"
        + (f", last ended {rows[-1].end:%d.%m. %H:%M}" if rows else ""),
    )
    return 1 if failed else 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="zyt", description=__doc__.split("\n\n")[1])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("link", help="symlink the Spoon into ~/.hammerspoon/Spoons").set_defaults(run=cmd_link)
    sub.add_parser("unlink", help="remove that symlink").set_defaults(run=cmd_unlink)
    sub.add_parser("status", help="what is running now").set_defaults(run=cmd_status)
    for name in ("work", "private", "auto"):
        sub.add_parser(
            name, help=f"pin the class to {name}" if name != "auto" else "let the rules decide"
        ).set_defaults(run=cmd_switch)
    for name, when in (("day", "YYYY-MM-DD"), ("week", "YYYY-Www")):
        report = sub.add_parser(name, help=f"the recorded {name} and its booking proposal")
        report.add_argument("when", nargs="?", metavar=when)
        report.add_argument("--json", action="store_true")
        report.set_defaults(run=cmd_report)
    board = sub.add_parser("board", help="the same week or day as one HTML file, and open it")
    board.add_argument("when", nargs="?", metavar="YYYY-Www|YYYY-MM-DD")
    board.add_argument("--out", metavar="FILE", help=f"where to write it, default {STATE / 'board.html'}")
    board.add_argument("--no-open", action="store_true", help="write it and leave it closed")
    board.set_defaults(run=cmd_board)
    hook = sub.add_parser("hook", help="stdin hook for a coding tool (Claude Code)")
    hook.add_argument("tool", choices=["claude-code"])
    hook.set_defaults(run=cmd_hook)
    context = sub.add_parser("context", help="note which directory a tool is working in")
    context.add_argument("source")
    context.add_argument("cwd", nargs="?", default=".")
    context.set_defaults(run=cmd_context)
    sub.add_parser("doctor", help="check the installation").set_defaults(run=cmd_doctor)
    args = parser.parse_args(argv)
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
