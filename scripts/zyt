#!/usr/bin/env python3
"""The command line half of zyt.

Link the Spoon into Hammerspoon, switch the class by hand, say what is wrong,
and turn the rows the Spoon writes into a week you can book: weekdays only,
inside the hours you set, in blocks no longer than you allow, with a break
between them, and not a minute more or less than was recorded.

Standard library only, and nothing newer than the python3 a Mac ships with.
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import csv
import datetime as dt
import fcntl
import hashlib
import html
import http.server
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zoneinfo
from dataclasses import dataclass
from pathlib import Path

# The Spoon carries the same number in Zyt.spoon/init.lua, and the release
# workflow refuses a tag that disagrees with either of them.
VERSION = "1.0.0"

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "zyt" / "rules.json"
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "zyt"
SPOONS = HOME / ".hammerspoon" / "Spoons"
LOAD_LINE = 'hs.loadSpoon("Zyt"):start()'
HS_IN_APP = "/Applications/Hammerspoon.app/Contents/Frameworks/hs/hs"

# One note per chat session, kept for long enough that a session picked up the
# next morning still finds its own, and no longer: the Spoon reads the whole
# directory on every tick. A session id has to be a plain file name; anything
# else is not written rather than sanitised into somebody else's note.
SESSION_TTL = 3 * 24 * 3600
SESSION_NAME = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\Z")
# One lock for the whole directory, rather than one per session, so that there
# is a single file nobody has to decide when to delete. A merge is a read and a
# rename of a few hundred bytes; sessions waiting their turn cost nothing.
SESSION_LOCK = ".lock"

# "nobody has looked the remote up yet", as opposed to "looked, and there is
# none". Asking git costs a process, and one hook event needs the answer twice.
UNKNOWN = object()

# How much of a transcript is read to find the title, and how long a title may
# be before it is cut. The tool rewrites the title on every exchange, so the end
# of the file is where it is: measured over the seventeen transcripts on this
# machine that carry a title somebody typed in by hand, the newest of them sat
# 28.9 KB from the end at the worst, in a file of 37 MB.
TRANSCRIPT_TAIL = 256 * 1024
TITLE_MAX = 60

REPORT_DEFAULTS = {
    "workdays": [1, 2, 3, 4, 5],
    "earliest": "07:00",
    # No block ends after this. Null is a day with no closing time, for a
    # record where the hours are the hours: the week is booked instead of
    # leaving a remainder that no day would take.
    "latest": "20:00",
    "maxBlockMinutes": 300,
    "breakMinutes": 30,
    # The break between two blocks is lunch, so it belongs at midday rather
    # than wherever five hours of work happen to end. Set it to null for a day
    # that is only blocks and breaks.
    "lunch": {"earliest": "11:15", "latest": "13:00"},
    "defaultStart": "08:00",
    "fillEmptyDays": False,
    # A private stretch at least this long is kept out of the proposal: the
    # blocks go round it rather than over it. Below it they are left alone,
    # because private time on a workday arrives as slivers — a glance at a
    # chat, a message answered — and a block cut at every one of them would be
    # twenty blocks nobody can book. Null keeps every stretch out, however
    # short.
    "skipPrivateMinutes": 30,
}
# The calendar half. Times come back from Graph in UTC and are turned into
# epoch seconds here, so the Spoon parses nothing. The scopes are what a token
# is asked for; the app registration decides what it may have.
MEETING_DEFAULTS = {
    "enabled": False,
    "tenantId": None,
    "clientId": None,
    "redirectUri": "http://localhost:3000",
    "class": "work",
    # What an event has to say about the time it takes. `free` never counts, and
    # `workingElsewhere` is a day somewhere else rather than a meeting.
    "statuses": ["busy", "oof", "tentative"],
    # Subjects that mean the hour is not work: a team event, a drink, whatever
    # is in the diary because people are in the same room rather than because
    # anybody is working. Matched as text inside the subject, case ignored.
    "skipSubjects": [],
    "minimumSeconds": 300,
    "lookbackHours": 24,
}
GRAPH = "https://graph.microsoft.com/v1.0"
GRAPH_SCOPES = "offline_access Calendars.Read"
KEYCHAIN_SERVICE = "zyt-graph"
# How long the one interactive sign-in waits for the browser to come back.
SIGN_IN_SECONDS = 300

# The source a row written from the calendar carries, which is also the name of
# the lane it is drawn on.
MEETING = "meeting"

CHUNK_MINUTES = 15
# How close two recorded segments of one class have to be for the board to draw
# them as one bar. A tick that flickered between the classes and back leaves a
# run of segments seconds long each, and a lane of those is a smear.
JOIN_SECONDS = 60


# ---------------------------------------------------------------------------
# Rules


def load_rules(path=None) -> dict:
    path = path or CONFIG
    try:
        rules = json.loads(path.read_text())
    except FileNotFoundError:
        rules = {}
    except ValueError as error:
        raise SystemExit(f"{path}: the rules file is not valid JSON: {error}") from None
    if not isinstance(rules, dict):
        raise SystemExit(f"{path}: the rules file has to hold a JSON object")
    given = rules.get("report")
    if given is None:
        given = {}
    if not isinstance(given, dict):
        raise SystemExit(f"{path}: report has to be a JSON object")
    report = dict(REPORT_DEFAULTS)
    report.update(given)
    check_window(path, report)
    rules["report"] = report
    given = rules.get("meetings")
    if given is None:
        given = {}
    if not isinstance(given, dict):
        raise SystemExit(f"{path}: meetings has to be a JSON object")
    meetings = dict(MEETING_DEFAULTS)
    meetings.update(given)
    rules["meetings"] = meetings
    return rules


def minutes(clock: str) -> int:
    hours, mins = clock.split(":")
    return int(hours) * 60 + int(mins)


def a_clock(path, label: str, value) -> int:
    """`value` as minutes from midnight, or the file is wrong and says so.

    `minutes` is the parser the rest of the code uses and it takes what it is
    given: `"7:60"` comes back as 8 o'clock and `"08:00:00"` as a crash. Here
    is where a rules file is read, so here is where a clock has to look like
    one."""
    if not isinstance(value, str) or not re.fullmatch(r"([01][0-9]|2[0-4]):[0-5][0-9]", value):
        raise SystemExit(f'{path}: {label} has to be a clock such as "08:00", not {value!r}')
    at = minutes(value)
    if at > 24 * 60:
        raise SystemExit(f"{path}: {label} is past the end of the day: {value}")
    return at


def check_window(path, report: dict) -> None:
    """Every time of day in the rules, before anything is worked out from
    them. `latest` may be null, which is a day with no closing time; everything
    else has to be a clock, and each pair has to end after it starts. Without
    this a typo is a silent answer: `""` or `0` read as no closing time at all,
    and `"00:00"` closes the day before it opens and books nothing all week."""
    opens = a_clock(path, "report.earliest", report.get("earliest"))
    if report.get("latest") is not None:
        closes = a_clock(path, "report.latest", report.get("latest"))
        if closes <= opens:
            raise SystemExit(f"{path}: report.latest ({report['latest']}) is not after report.earliest")
    a_clock(path, "report.defaultStart", report.get("defaultStart"))
    lunch = report.get("lunch")
    if lunch is None:
        return
    if not isinstance(lunch, dict):
        raise SystemExit(f"{path}: report.lunch has to be a JSON object, or null for a day without one")
    early = a_clock(path, "report.lunch.earliest", lunch.get("earliest"))
    late = a_clock(path, "report.lunch.latest", lunch.get("latest"))
    if late <= early:
        raise SystemExit(f"{path}: report.lunch.latest ({lunch['latest']}) is not after report.lunch.earliest")


def clock(total: int) -> str:
    return f"{total // 60:02d}:{total % 60:02d}"


def second(total: int) -> str:
    """Seconds from midnight as a clock that shows them, for a stretch whose
    whole length is seconds."""
    return f"{total // 3600:02d}:{total // 60 % 60:02d}:{total % 60:02d}"


# ---------------------------------------------------------------------------
# Intervals


@dataclass
class Segment:
    start: dt.datetime
    end: dt.datetime
    cls: str
    source: str = ""

    @property
    def kind(self) -> str:
        """What the bar is: an hour at the keyboard, or one the calendar
        accounted for. Both are work; they are not the same thing to look at."""
        return MEETING if self.source == MEETING else self.cls

    @property
    def seconds(self) -> int:
        return int((self.end - self.start).total_seconds())


def read_intervals(path: Path) -> list:
    if not path.exists():
        return []
    segments = []
    with path.open(newline="") as handle:
        for row in csv.DictReader(handle):
            try:
                start = dt.datetime.fromisoformat(row["start"])
                end = dt.datetime.fromisoformat(row["end"])
            except (KeyError, TypeError, ValueError):
                continue
            if end > start and row.get("class") in ("work", "private"):
                segments.append(Segment(start, end, row["class"], row.get("source") or ""))
    return segments


def split_by_day(segments: list) -> list:
    """Cut every segment at local midnight, so a day adds up to its own hours."""
    out = []
    for segment in segments:
        start = segment.start
        while start.date() < segment.end.date():
            midnight = dt.datetime.combine(start.date() + dt.timedelta(days=1), dt.time(), tzinfo=start.tzinfo)
            out.append(Segment(start, midnight, segment.cls, segment.source))
            start = midnight
        if segment.end > start:
            out.append(Segment(start, segment.end, segment.cls, segment.source))
    return out


def spans(segments: list) -> list:
    """The stretches a list of segments covers between them, merged and in
    order. Two segments over the same minute are one stretch: somebody at the
    keyboard in a meeting is doing both, the record says both, and the day is
    still the day."""
    merged = []
    for segment in sorted(segments, key=lambda s: s.start):
        if merged and segment.start <= merged[-1][1]:
            if segment.end > merged[-1][1]:
                merged[-1][1] = segment.end
        else:
            merged.append([segment.start, segment.end])
    return merged


def without(stretches: list, holes: list) -> list:
    """`stretches` with every minute of `holes` taken out of them. The holes
    are put in order here rather than being assumed to be in it: a caller that
    hands them over unsorted would otherwise keep the ones that came late."""
    holes = sorted(holes)
    out = []
    for start, end in stretches:
        cursor = start
        for hole_start, hole_end in holes:
            if hole_end <= cursor or hole_start >= end:
                continue
            if hole_start > cursor:
                out.append([cursor, hole_start])
            cursor = max(cursor, hole_end)
            if cursor >= end:
                break
        if cursor < end:
            out.append([cursor, end])
    return out


def seconds(stretches: list) -> int:
    return sum(int((end - start).total_seconds()) for start, end in stretches)


def covered(segments: list) -> int:
    """The seconds a list of segments covers between them."""
    return seconds(spans(segments))


def minute_span(start, end) -> dict:
    """A stretch as minutes from the midnight its day began at, with the whole
    minute it ends in included: a stretch kept out of the booking keeps every
    second of itself out, at both ends. Measured from that one midnight rather
    than from each end's own, because a stretch that runs to midnight ends at
    00:00 of the day after and 00:00 is not before 23:00.

    `first` and `last` are the same two moments in seconds from that midnight,
    which is the stretch as it really was. The minutes are the shape it takes
    up and are rounded outwards, so a stretch of 29 minutes and 50 seconds
    would otherwise count as 31, and an overlap of one second as a whole
    minute. Both are kept: the minutes decide where a block may stand, the
    seconds decide how long anything lasted.
    """
    midnight = dt.datetime.combine(start.date(), dt.time(), tzinfo=start.tzinfo)
    first = int((start - midnight).total_seconds())
    last = int((end - midnight).total_seconds())
    return {
        "from": first // 60,
        "to": min(-(-last // 60), 24 * 60),
        "first": first,
        "last": last,
    }


def summarise(day_segments: list) -> dict:
    work = sorted((s for s in day_segments if s.cls == "work"), key=lambda s: s.start)
    private = [s for s in day_segments if s.cls == "private"]
    longest_break = 0
    reach = None
    for segment in work:
        if reach is not None and segment.start > reach:
            longest_break = max(longest_break, int((segment.start - reach).total_seconds()))
        if reach is None or segment.end > reach:
            reach = segment.end
    # A minute spent privately is not a work minute, whatever else says it is.
    # The calendar writes a meeting as one stretch and the keyboard goes on
    # recording underneath it, so a glance at a private chat during a meeting
    # arrives as work and as private at once. Work is what is left of it: the
    # booking proposal is built from this figure, and the one rule it has to
    # keep is that nothing private is in it.
    private_spans = spans(private)
    at_work = without(spans(work), private_spans)
    # What the calendar accounted for, with the same private minutes taken out
    # of it, so that it stays a part of the work figure rather than a second
    # figure that can be larger than the one it is inside.
    from_calendar = without(spans([s for s in day_segments if s.source == MEETING]), private_spans)
    return {
        "start": at_work[0][0] if at_work else None,
        "end": at_work[-1][1] if at_work else None,
        "work": seconds(at_work),
        "meeting": seconds(from_calendar),
        "private": covered(private),
        # Minutes from midnight, because that is what the proposal works in.
        "privateAt": [minute_span(start, end) for start, end in private_spans],
        "break": longest_break,
    }


def week_segments(segments: list, monday: dt.date) -> dict:
    """The seven days of that week, each with the segments recorded in it, cut at
    midnight and in order. The report adds them up; the board draws them."""
    days = {monday + dt.timedelta(days=i): [] for i in range(7)}
    for segment in split_by_day(segments):
        day = segment.start.date()
        if day in days:
            days[day].append(segment)
    for items in days.values():
        items.sort(key=lambda segment: segment.start)
    return days


def week_days(segments: list, monday: dt.date) -> dict:
    return {day: summarise(items) for day, items in week_segments(segments, monday).items()}


# ---------------------------------------------------------------------------
# The booking proposal


def kept_out(summary: dict, report: dict) -> list:
    """The private stretches the booking has to go round: the ones inside the
    window that are at least `skipPrivateMinutes` long, clipped to it."""
    floor = report.get("skipPrivateMinutes")
    if floor is None:
        floor = 0
    opens, closes = minutes(report["earliest"]), latest_minute(report)
    out = []
    for stretch in summary.get("privateAt") or []:
        start, end = max(stretch["from"], opens), min(stretch["to"], closes)
        if end <= start:
            continue
        # The minutes are rounded outwards and the seconds are not, so the
        # shorter of the two is the length. A stretch that hangs over an end of
        # the window is as long as the part inside it.
        lasted = min(stretch["last"] - stretch["first"], (end - start) * 60)
        if lasted >= max(floor, 1) * 60:
            out.append([start, end])
    return out


def rooms(report: dict, busy: list) -> list:
    """The stretches of the window a block may stand in: the window itself,
    less the private time kept out of it."""
    opens, closes = minutes(report["earliest"]), latest_minute(report)
    free, cursor = [], opens
    for start, end in sorted(busy):
        if start > cursor:
            free.append([cursor, min(start, closes)])
        cursor = max(cursor, end)
        if cursor >= closes:
            break
    if cursor < closes:
        free.append([cursor, closes])
    return [room for room in free if room[1] > room[0]]


def fill(free: list, total: int, report: dict, midday: int = 0) -> list:
    """Lay `total` minutes into `free`, in order: blocks of at most
    `maxBlockMinutes` with a break between them, and the first one ending at
    `midday` when one is given.

    A stretch that was left out is itself a gap, so crossing one is a break
    already when it is long enough to be one; a shorter one is topped up at the
    start of the next room. What does not fit is left unplaced, and the caller
    is the one that has to say so."""
    blocks, remaining, owed = [], total, 0
    for index, (opens, closes) in enumerate(free):
        cursor = opens + owed if index else opens
        owed = 0
        while remaining > 0 and cursor < closes:
            block = min(report["maxBlockMinutes"], remaining, closes - cursor)
            if midday and not blocks:
                block = min(block, max(midday - cursor, 0))
            if block <= 0:
                break
            blocks.append([cursor, cursor + block])
            cursor += block + report["breakMinutes"]
            remaining -= block
        if remaining <= 0:
            break
        if index + 1 < len(free):
            # The break the next block owes, less the gap that was skipped.
            owed = max(0, report["breakMinutes"] - (free[index + 1][0] - closes))
    return blocks


def capacity(report: dict, busy: list = ()) -> int:
    """The most minutes one day can hold: blocks and breaks inside the window,
    going round the private time kept out of it."""
    free = rooms(report, list(busy))
    held = 0
    for index, (opens, closes) in enumerate(free):
        window = closes - opens
        if index:
            window -= max(0, report["breakMinutes"] - (opens - free[index - 1][1]))
        while window > 0:
            block = min(report["maxBlockMinutes"], window)
            held += block
            window -= block + report["breakMinutes"]
    return held


def anchor(summary: dict, report: dict) -> int:
    """Where the first block starts: the real start when it fits, rounded down
    to five minutes and kept inside the window."""
    start = summary["start"]
    if start is None:
        return minutes(report["defaultStart"])
    at = start.hour * 60 + start.minute
    at -= at % 5
    return min(max(at, minutes(report["earliest"])), latest_minute(report))


def latest_minute(report: dict) -> int:
    """The minute no block may end after. `null` is a day with no closing
    time: the hours are what they are, and a week that does not fit inside an
    evening is booked rather than reported as a remainder nobody can enter.
    Midnight is the end either way, because a day ends.
    """
    return 24 * 60 if report.get("latest") is None else minutes(report["latest"])


def lunch_end(start: int, total: int, report: dict) -> int:
    """When the first block ends on a day that has a lunch break: inside the
    lunch window, no longer than one block, and never past what is left to
    book. Zero when the day cannot have one, which is a day short enough to
    need no break, one that starts after the window has gone by, and one that
    starts early enough for a whole block to end before lunch could begin."""
    lunch = report.get("lunch")
    if not lunch or total <= report["maxBlockMinutes"]:
        return 0
    earliest, latest = minutes(lunch["earliest"]), minutes(lunch["latest"])
    end = min(start + report["maxBlockMinutes"], latest - report["breakMinutes"])
    morning = end - start
    # A block is never stretched to reach the window, and a morning has to
    # leave something for the afternoon.
    if end < earliest or morning <= 0 or morning >= total:
        return 0
    return end


def blocks_from(start: int, total: int, report: dict, midday: int = 0) -> list:
    """Blocks of at most maxBlockMinutes with a break between, from `start`.
    With `midday` the first block ends there, which is where lunch goes."""
    blocks = []
    cursor, remaining = start, total
    if midday:
        blocks.append([cursor, midday])
        remaining -= midday - cursor
        cursor = midday + report["breakMinutes"]
    while remaining > 0:
        block = min(report["maxBlockMinutes"], remaining)
        blocks.append([cursor, cursor + block])
        cursor += block + report["breakMinutes"]
        remaining -= block
    return blocks


def layout_around(start: int, total: int, report: dict, busy: list) -> list:
    """The same as `layout`, on a day with private time the blocks go round.

    The day still starts where it started: the rooms before the anchor are left
    alone while the rest can hold the hours. When they cannot, the day reaches
    back into them, the way a day that would run past `latest` is moved earlier
    as a whole.

    Lunch is placed as it is on any other day, unless a stretch that was left
    out already falls in the lunch window: that stretch is the break, and
    another one in the same hour would be asking twice."""
    free = rooms(report, busy)
    after = [[max(opens, start), closes] for opens, closes in free if closes > start]
    if not after and not free:
        return []
    lunch = report.get("lunch")
    asked = lunch is not None and not any(
        end > minutes(lunch["earliest"]) and begins < minutes(lunch["latest"]) for begins, end in busy
    )

    def best(spare: list) -> list:
        if not spare:
            return []
        midday = lunch_end(spare[0][0], total, report) if asked else 0
        if midday > spare[0][1]:
            midday = 0
        blocks = fill(spare, total, report, midday)
        if midday and placed(blocks) < total:
            blocks = fill(spare, total, report)
        return blocks

    # The hours go after the start where they fit. Whether they fit is what the
    # layout says and not what the rooms add up to: the breaks take their own
    # minutes out of a room, so rooms as long as the hours can still be too
    # short for them. When they are, the day reaches back into the morning,
    # the way a day that would run past `latest` is moved earlier as a whole.
    blocks = best(after)
    if placed(blocks) < total:
        whole = best(free)
        if placed(whole) > placed(blocks):
            return whole
    return blocks


def placed(blocks: list) -> int:
    """The minutes a layout has found room for."""
    return sum(end - start for start, end in blocks)


def private_under(summary: dict, blocks: list) -> int:
    """The seconds of private time a day's blocks stand over.

    None of it is booked: the hours come from `summarise`, which has already
    taken every private second out of them, and a block is as long as the hours
    are. It is the clock a block was drawn across that holds private minutes,
    and the stretches too short to be kept out of the layout
    (`skipPrivateMinutes`) are the ones that end up under one. Saying how many
    is the only way the figure can be checked instead of believed.

    The overlap is measured in seconds against the stretch as it really was,
    not against the minutes it is drawn over: a block ending at 09:01 and a
    stretch from 09:00:59 holds one second of it, not a minute. The blocks are
    merged first, so a minute two of them stand over is one minute. A layout
    does not hand over two blocks on one minute, and a figure that would be
    wrong if it did is a figure nobody can lean on.
    """
    merged, total = [], 0
    for start, end in sorted(blocks):
        if merged and start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    for stretch in summary.get("privateAt") or []:
        for start, end in merged:
            total += max(0, min(stretch["last"], end * 60) - max(stretch["first"], start * 60))
    return total


def layout(start: int, total: int, report: dict, busy: list = ()) -> list:
    """Blocks of at most maxBlockMinutes with a break between, ending no later
    than `latest`; shifted earlier as a whole when they would.

    The first break is lunch and it is put at midday, because that is when it
    is taken. Without that it lands wherever the first block happens to end,
    which on a day that started at nine is the middle of the afternoon.

    Lunch is placed against the start the day ends up with, not the one it came
    in with: a day that has to be shifted earlier to fit would otherwise carry
    its lunch break out of the window with it. A day that cannot hold the extra
    break the split costs keeps the plain layout, where the break falls where
    it falls and every block is still the length it should be.

    With `busy` the day has private stretches in it that no block may cover,
    and `layout_around` is what lays it out."""
    if busy:
        return layout_around(start, total, report, list(busy))
    plain = blocks_from(start, total, report)
    if plain:
        overshoot = plain[-1][1] - latest_minute(report)
        if overshoot > 0:
            plain = [[s - overshoot, e - overshoot] for s, e in plain]
    if not plain:
        return plain
    midday = lunch_end(plain[0][0], total, report)
    if not midday:
        return plain
    split = blocks_from(plain[0][0], total, report, midday)
    if split[-1][1] <= latest_minute(report):
        return split
    return plain


def deal(pool: int, booked: dict, caps: dict, eligible: list) -> int:
    """Hand the pool out to the days with the fewest hours first, a chunk at a
    time, and answer with what found no room."""
    while pool > 0:
        room = [day for day in eligible if booked[day] < caps[day]]
        if not room:
            break
        day = min(room, key=lambda d: (booked[d], d))
        added = min(CHUNK_MINUTES, pool, caps[day] - booked[day])
        booked[day] += added
        pool -= added
    return pool


def propose(days: dict, report: dict) -> tuple:
    """Redistribute the week's work onto its workdays.

    Every recorded minute is kept and none is invented, and no minute spent
    privately is in here at all: `summarise` has already taken those out of the
    hours, and the longer stretches are kept out of the blocks as well, so a
    booking never stands over an hour that was not work. A workday keeps its
    own hours up to the day's capacity; what does not fit, and everything from
    the other days, is dealt out to the workdays with the fewest hours first.
    What still finds no room is returned as the leftover, so it is seen rather
    than lost.
    """
    workdays = [day for day in sorted(days) if day.isoweekday() in report["workdays"]]
    busy = {day: kept_out(days[day], report) for day in workdays}
    caps = {day: capacity(report, busy[day]) for day in workdays}
    recorded = {day: days[day]["work"] // 60 for day in days}
    booked = {day: min(recorded[day], caps[day]) for day in workdays}
    pool = sum(recorded[day] for day in days if day not in booked)
    pool += sum(recorded[day] - booked[day] for day in workdays)
    eligible = [day for day in workdays if recorded[day] > 0 or report["fillEmptyDays"]]
    pool = deal(pool, booked, caps, eligible)
    # The blocks are what a day is booked as, so the layout has the last word
    # on the figure. A minute it could not stand anywhere goes back into the
    # pool and is dealt out again, to a day that can hold it; the day it came
    # from keeps what was laid out as its ceiling, so the same minute cannot
    # come back to it and bounce for ever. What no day can place is the
    # leftover, which is the one thing this function is allowed to lose.
    blocks = {}
    while True:
        short = 0
        for day in workdays:
            blocks[day] = layout(anchor(days[day], report), booked[day], report, busy[day])
            missing = booked[day] - placed(blocks[day])
            if missing > 0:
                booked[day] = placed(blocks[day])
                caps[day] = booked[day]
                short += missing
        if short == 0:
            break
        pool += short
        room = [day for day in eligible if booked[day] < caps[day]]
        if not room:
            break
        pool = deal(pool, booked, caps, eligible)
    return blocks, booked, pool


# ---------------------------------------------------------------------------
# Rendering


def fmt_h(seconds: int) -> str:
    total = max(0, int(seconds)) // 60
    return f"{total // 60}h{total % 60:02d}"


def fmt_small(seconds: int) -> str:
    """The same, except that something shorter than a minute says so rather
    than printing as nothing at all."""
    return fmt_h(seconds) if seconds >= 60 else "under a minute"


def fmt_m(mins: int) -> str:
    return f"{mins // 60}h{mins % 60:02d}"


def fmt_at(moment) -> str:
    return moment.strftime("%H:%M") if moment else "  -  "


def parse_week(text: str) -> dt.date:
    year, week = text.upper().split("-W")
    return dt.date.fromisocalendar(int(year), int(week), 1)


def week_of(day: dt.date) -> str:
    year, week, _ = day.isocalendar()
    return f"{year}-W{week:02d}"


def period(when, single: bool) -> tuple:
    """The Monday to work out, and the one day asked for or None. A day is still
    worked out through its whole week: a day's booking is the week's minutes
    dealt round, and the row for the day is then taken out of that."""
    today = dt.date.today()
    # A typo in a date is a thing the person can fix, so it is said in a line
    # rather than raised as a traceback at them.
    try:
        if single:
            day = dt.date.fromisoformat(when) if when else today
            return day - dt.timedelta(days=day.weekday()), day
        monday = parse_week(when) if when else today - dt.timedelta(days=today.weekday())
    except ValueError:
        wants = "a day, YYYY-MM-DD" if single else "a week, YYYY-Www"
        raise SystemExit(f"{when}: no such date; it wants {wants}") from None
    return monday, None


def booking_of(day: dt.date, summary: dict, blocks: dict) -> str:
    if day in blocks:
        return ", ".join(f"{clock(s)}-{clock(e)}" for s, e in blocks[day]) or "-"
    return "moved to the workdays" if summary["work"] else "-"


def render_week(monday: dt.date, days: dict, blocks: dict, booked: dict, leftover, title=None) -> str:
    """The record on the left, the proposal on the right. Every figure is in
    whole minutes per day, the totals included, so the footer adds up to the
    rows above it. `leftover` is None for a single day: it belongs to the week."""
    sunday = monday + dt.timedelta(days=6)
    bookings = {day: booking_of(day, days[day], blocks) for day in days}
    width = max(len(text) for text in bookings.values()) + 2
    lines = [
        title or f"Week {week_of(monday)}  {monday:%d.%m.} to {sunday:%d.%m.%Y}",
        "",
        f"{'':11}{'recorded':<36}  {'proposal'}",
        f"{'day':<11}{'start':<7}{'end':<7}{'work':<7}{'private':<9}{'break':<6}  {'booking':<{width}}{'booked'}",
    ]
    total_work = total_private = total_booked = total_under = 0
    for day in sorted(days):
        summary = days[day]
        total_work += summary["work"] // 60
        total_private += summary["private"] // 60
        total_under += private_under(summary, blocks.get(day, []))
        amount = "-"
        if day in blocks:
            amount = fmt_m(booked[day])
            total_booked += booked[day]
        lines.append(
            f"{day:%a %d.%m.}  {fmt_at(summary['start']):<7}{fmt_at(summary['end']):<7}"
            f"{fmt_h(summary['work']):<7}{fmt_h(summary['private']):<9}{fmt_h(summary['break']):<6}  "
            f"{bookings[day]:<{width}}{amount}"
        )
    lines.append("")
    footer = f"recorded {fmt_m(total_work)} work, {fmt_m(total_private)} private  ·  booked {fmt_m(total_booked)}"
    if leftover is not None:
        footer += f"  ·  left over {fmt_m(leftover)}"
    lines.append(footer)
    if total_under:
        lines.append(
            f"none of the private time is booked; {fmt_small(total_under)} of it is under a block, "
            "in stretches too short to be laid round"
        )
    return "\n".join(lines)


def week_json(days: dict, blocks: dict, booked: dict, leftover: int) -> dict:
    return {
        "days": {
            day.isoformat(): {
                "start": summary["start"].isoformat() if summary["start"] else None,
                "end": summary["end"].isoformat() if summary["end"] else None,
                "work": summary["work"],
                # Part of `work`, not beside it: the hours of it the calendar
                # accounted for, private minutes already out of both.
                "meeting": summary["meeting"],
                "private": summary["private"],
                "break": summary["break"],
                "booking": [[clock(s), clock(e)] for s, e in blocks.get(day, [])],
                "booked": booked.get(day, 0) * 60,
                # Booked time is work only. This is the private time the blocks
                # were drawn across, which is not the same thing and is said so
                # that it can be checked.
                "privateUnderBooking": private_under(summary, blocks.get(day, [])),
            }
            for day, summary in sorted(days.items())
        },
        "leftover": leftover * 60 if leftover is not None else None,
    }


# ---------------------------------------------------------------------------
# The board

# One file, no script, nothing fetched: a board is a drawing of the week, and a
# drawing of somebody's week does not need a network (ADR 0011).

# How often the live board asks the browser to read it again. The Spoon rewrites
# the file on the same interval, and `BOARD_REFRESH_SECONDS` in
# Zyt.spoon/init.lua is the other half of this number: a reload that finds the
# same file shows nothing new, and a rewrite nobody reloads is invisible, so the
# two have to agree (ADR 0015).
BOARD_REFRESH_SECONDS = 300

BOARD_STYLE = """
