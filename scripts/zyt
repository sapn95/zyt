def span_of(segment: Segment) -> tuple:
    """A segment as minutes from the midnight of the day it starts in. One that
    was cut at midnight ends at 1440 here, rather than back at nothing."""
    midnight = dt.datetime.combine(segment.start.date(), dt.time(), tzinfo=segment.start.tzinfo)
    return (segment.start - midnight).total_seconds() / 60, (segment.end - midnight).total_seconds() / 60


def scale(segments: dict, blocks: dict, report: dict) -> tuple:
    """The first and last whole hour on show: the hours that may be booked,
    widened around anything recorded or proposed outside them. An evening on the
    laptop is drawn where it happened rather than clipped off the end."""
    first, last = minutes(report["earliest"]) // 60, -(-minutes(report["latest"]) // 60)
    edges = [span_of(segment) for items in segments.values() for segment in items]
    edges += [(start, end) for items in blocks.values() for start, end in items]
    for start, end in edges:
        first = min(first, int(start // 60))
        last = max(last, int(-(-end // 60)))
    return first, max(last, first + 1)


def joined(segments: list) -> list:
    """The same hours, in as few bars as tell the truth: a run of segments of one
    class with no real gap between them becomes one. Nothing is added up
    differently, and where the class actually changed it still changes."""
    out = []
    for segment in segments:
        last = out[-1] if out else None
        if last and last.cls == segment.cls and (segment.start - last.end).total_seconds() <= JOIN_SECONDS:
            last.end = max(last.end, segment.end)
        else:
            out.append(Segment(segment.start, segment.end, segment.cls))
    return out


def said(segment: Segment) -> str:
    """What a bar says when it is hovered. A segment with no whole minute in it says
    its seconds: a sliver that claimed to have taken 0h00 would be a lie about the
    one thing it is there to report."""
    if segment.seconds < 60:
        return f"{segment.cls} {segment.start:%H:%M:%S}, {segment.seconds}s"
    return f"{segment.cls} {segment.start:%H:%M} to {segment.end:%H:%M}, {fmt_h(segment.seconds)}"


def bars(spans: list, first: int, total: int) -> str:
    """One positioned bar per span, as a percentage of the hours on show. The
    title is what a bar says when it is too narrow to say anything itself."""
    out = []
    for start, end, kind, label in spans:
        left = (start - first * 60) / total * 100
        width = (end - start) / total * 100
        out.append(
            f'<span class="{kind}" style="left:{left:.4f}%;width:{width:.4f}%" title="{html.escape(label)}"></span>'
        )
    return "".join(out)


def by_week(segments: list) -> dict:
    """The rows cut at midnight and filed under the Monday of the week they fall
    in. A file of many weeks then walks the rows once instead of once a week."""
    out = {}
    for part in split_by_day(segments):
        day = part.start.date()
        out.setdefault(day - dt.timedelta(days=day.weekday()), []).append(part)
    return out


def board_weeks(grouped: dict, monday: dt.date) -> list:
    """The Mondays the file holds: from the first week with something recorded in
    it to the last, and the week asked for even when it lies outside them. A week
    nobody worked stays in the row, so the arrows run on without a gap."""
    mondays = set(grouped) | {monday}
    out, week = [], min(mondays)
    while week <= max(mondays):
        out.append(week)
        week += dt.timedelta(days=7)
    return out


def board_nav(older, newer) -> str:
    """The way back and forward, as two links into the same file. Following one
    fetches nothing, and at either end the week that is not there is said in dim
    words rather than left as a link that would go nowhere."""

    def side(week, side_class, text):
        if week is None:
            return f'<span class="edge {side_class}">{html.escape(text)}</span>'
        return f'<a class="{side_class}" href="#w{week}">{html.escape(text)}</a>'

    return (
        "<nav>"
        + side(older, "older", f"‹ {older}" if older else "‹ nothing earlier")
        + side(newer, "newer", f"{newer} ›" if newer else "nothing later ›")
        + "</nav>"
    )


def board_week(days, segments, blocks, booked, leftover, report, heading, sub, ident, nav="", current=False) -> str:
    """One week drawn: per day the hours recorded on the upper lane and the
    proposal on the lower one, both on the same hour scale, so that what would be
    booked can be held against what happened."""
    first, last = scale(segments, blocks, report)
    total = (last - first) * 60
    # Every hour is named while the names still have room; a day that reaches
    # from before dawn to after midnight gets every second one instead.
    step = 1 if last - first <= 18 else 2
    ticks = "".join(
        f'<span style="left:{(hour - first) * 60 / total * 100:.4f}%">{hour:02d}</span>'
        for hour in range(first, last + 1, step)
    )
    rows = [f'<div class="row axis"><div></div><div class="track">{ticks}</div><div></div></div>']
    work = private = filled = 0
    for day in sorted(days):
        summary = days[day]
        work += summary["work"] // 60
        private += summary["private"] // 60
        recorded = [(*span_of(segment), segment.cls, said(segment)) for segment in joined(segments.get(day, []))]
        proposed = [
            (start, end, "book", f"book {clock(start)} to {clock(end)}, {fmt_m(end - start)}")
            for start, end in blocks.get(day, [])
        ]
        figures = f"<b>{fmt_h(summary['work'])}</b>"
        if summary["private"]:
            figures += f"<span>{fmt_h(summary['private'])} private</span>"
        if day in blocks:
            filled += booked[day]
            booking = " · ".join(f"{clock(start)}–{clock(end)}" for start, end in blocks[day]) or "nothing to book"
        else:
            booking = "moved to the workdays" if summary["work"] else "not a workday"
        rows.append(
            f'<div class="row"><div class="day"><b>{day:%a}</b> {day:%d.%m.}</div>'
            f'<div class="track"><div class="lane">{bars(recorded, first, total)}</div>'
            f'<div class="lane">{bars(proposed, first, total)}</div></div>'
            f'<div class="figures">{figures}<span class="booking">{html.escape(booking)}</span></div></div>'
        )
    totals = [(fmt_m(work), "recorded work"), (fmt_m(private), "private"), (fmt_m(filled), "booked")]
    if leftover is not None:
        totals.append((fmt_m(leftover), "left over"))
    return (
        f'<section class="week{" current" if current else ""}" id="{ident}">{nav}'
        f"<h1>{html.escape(heading)}</h1>"
        f'<p class="sub">{html.escape(sub)}</p>'
        '<ul class="totals">'
        + "".join(f"<li><b>{amount}</b>{html.escape(what)}</li>" for amount, what in totals)
        + "</ul>"
        + f'<section class="chart" style="--hour:{100 / (last - first):.4f}%">'
        + "".join(rows)
        + "</section></section>"
    )


def render_board(weeks: list, title: str) -> str:
    """The weeks as one file, the one asked for on show and the rest a link away.
    They are all written out because a page that could fetch the next week would
    need something to fetch it from, and this is a file (ADR 0011)."""
    keys = [("work", "recorded work"), ("private", "private"), ("book", "proposed booking")]
    source = str(STATE / "intervals.csv").replace(str(HOME), "~", 1)
    made = f"written {dt.datetime.now():%d.%m.%Y %H:%M} from {source} · one file, no script, nothing fetched"
    return "\n".join(
        [
            "<!doctype html>",
            '<html lang="en">',
            "<head>",
            '<meta charset="utf-8">',
            '<meta name="viewport" content="width=device-width, initial-scale=1">',
            f"<title>zyt · {html.escape(title)}</title>",
            f"<style>{BOARD_STYLE}</style>",
            "</head>",
            "<body>",
            "<main>",
            *weeks,
            "<footer>"
            + "".join(f'<span class="key"><i class="{kind}"></i>{html.escape(what)}</span>' for kind, what in keys)
            + f'<span class="made">{html.escape(made)}</span></footer>',
            "</main>",
            "</body>",
            "</html>",
            "",
        ]
    )


# ---------------------------------------------------------------------------
# Hammerspoon


def hs_binary() -> str:
    return shutil.which("hs") or HS_IN_APP


def hammerspoon_running() -> bool:
    try:
        return subprocess.run(["pgrep", "-x", "Hammerspoon"], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def hs_call(lua: str, timeout: float = 8.0):
    """Run Lua inside Hammerspoon and return its last line, or None when it is
    not running or does not answer. The running check comes first: `hs -A`
    would start Hammerspoon when it is down, and without `-A` the client stops
    in a prompt nobody sees. Neither is what a status command should do."""
    if not hammerspoon_running():
        return None
    try:
        done = subprocess.run([hs_binary(), "-A", "-c", lua], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = done.stdout.strip().splitlines()
    return lines[-1] if lines else None


def status() -> dict:
    answer = hs_call("return _G.zyt and _G.zyt:statusJSON() or 'null'")
    try:
        return json.loads(answer) if answer else None
    except ValueError:
        return None


# ---------------------------------------------------------------------------
# Commands


def brew_prefix():
    """Homebrew's opt path for zyt, which survives an upgrade; the Cellar path
    this script resolves to does not, and a symlink into it dies quietly."""
    brew = shutil.which("brew")
    if not brew:
        return None
    try:
        done = subprocess.run([brew, "--prefix", "zyt"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    prefix = Path(done.stdout.strip()) if done.returncode == 0 and done.stdout.strip() else None
    return prefix if prefix and prefix.exists() else None


def spoon_source() -> Path:
    resolved = Path(__file__).resolve()
    candidates = []
    if "/Cellar/" in str(resolved):
        prefix = brew_prefix()
        if prefix:
            candidates.append(prefix / "libexec" / "Zyt.spoon")
    candidates += [resolved.parent.parent / "Zyt.spoon", resolved.parent.parent / "libexec" / "Zyt.spoon"]
    for candidate in candidates:
        if (candidate / "init.lua").exists():
            return candidate
    raise SystemExit("cannot find Zyt.spoon next to this script")


def cmd_link(_args) -> int:
    SPOONS.mkdir(parents=True, exist_ok=True)
    target = SPOONS / "Zyt.spoon"
    source = spoon_source()
    if target.is_dir() and not target.is_symlink():
        print(f"{target} is a real directory, not a link; move it aside first", file=sys.stderr)
        return 1
    if target.is_symlink() or target.exists():
        target.unlink()
    target.symlink_to(source)
    print(f"linked {target} -> {source}")
    print()
    print("Add this to ~/.hammerspoon/init.lua and reload Hammerspoon:")
    print()
    print(f"    {LOAD_LINE}")
    print()
    if not CONFIG.exists():
        print(f"There is no rules file yet at {CONFIG}; examples/rules.json in the repository is a start.")
    return 0


def cmd_unlink(_args) -> int:
    target = SPOONS / "Zyt.spoon"
    if target.is_symlink() or target.exists():
        target.unlink()
        print(f"removed {target}")
    else:
        print(f"nothing at {target}")
    return 0


def cmd_status(_args) -> int:
    state = status()
    if not state:
        print("zyt is not running in Hammerspoon (try: zyt doctor)")
        return 1
    what = "away" if state.get("away") else f"{state['class']} since {state['since'][11:16]} ({state['source']})"
    if state.get("override"):
        what += ", pinned by hand"
    today = state.get("today") or {}
    print(f"{what}  ·  today {fmt_h(today.get('work', 0))} work, {fmt_h(today.get('private', 0))} private")
    return 0


def cmd_switch(args) -> int:
    lua = {"work": '"work"', "private": '"private"', "auto": "nil"}[args.command]
    answer = hs_call(f"return _G.zyt and _G.zyt:setOverride({lua}) or 'null'")
    if not answer or answer == "null":
        print("zyt is not running in Hammerspoon (try: zyt doctor)")
        return 1
    return cmd_status(args)


def cmd_report(args) -> int:
    rules = load_rules()
    monday, day = period(args.when, args.command == "day")
    days = week_days(read_intervals(STATE / "intervals.csv"), monday)
    blocks, booked, leftover = propose(days, rules["report"])
    title = None
    if day:
        days = {day: days[day]}
        leftover = None
        title = f"{day:%A %d.%m.%Y}  (week {week_of(day)})"
    if args.json:
        print(json.dumps(week_json(days, blocks, booked, leftover), indent=2))
    else:
        print(render_week(monday, days, blocks, booked, leftover, title))
    return 0


def drawn_week(recorded: list, monday: dt.date, report: dict, nav="", current=False) -> str:
    """One week worked out and drawn, from the rows of that week."""
    segments = week_segments(recorded, monday)
    days = {day: summarise(items) for day, items in segments.items()}
    blocks, booked, leftover = propose(days, report)
    return board_week(
        days,
        segments,
        blocks,
        booked,
        leftover,
        report,
        f"Week {week_of(monday)}",
        f"{monday:%A %d.%m.} to {monday + dt.timedelta(days=6):%A %d.%m.%Y}",
        f"w{week_of(monday)}",
        nav,
        current,
    )


def drawn_day(recorded: list, monday: dt.date, day: dt.date, report: dict) -> str:
    """The one day asked for, out of the week it was booked in: no arrows, because
    a day is something you ask for by name rather than page through."""
    segments = week_segments(recorded, monday)
    days = {each: summarise(items) for each, items in segments.items()}
    blocks, booked, _ = propose(days, report)
    return board_week(
        {day: days[day]},
        {day: segments[day]},
        blocks,
        booked,
        None,
        report,
        f"{day:%A %d.%m.%Y}",
        f"week {week_of(day)}",
        f"w{week_of(day)}",
        current=True,
    )


def cmd_board(args) -> int:
    """The week the report prints, drawn instead of tabulated, and opened. Every
    week with hours in it is written into the same file, so the arrows above a
    week go back and forward without another command. `--one-week` leaves the
    others out, for a file that is going to somebody else."""
    rules = load_rules()
    single = bool(args.when) and "-W" not in args.when.upper()
    monday, day = period(args.when, single)
    grouped = by_week(read_intervals(STATE / "intervals.csv"))
    this_week = grouped.get(monday, [])
    if day:
        title = f"{day:%A %d.%m.%Y}"
        weeks = [drawn_day(this_week, monday, day, rules["report"])]
    elif args.one_week:
        title = f"Week {week_of(monday)}"
        weeks = [drawn_week(this_week, monday, rules["report"], current=True)]
    else:
        title = f"Week {week_of(monday)}"
        mondays = board_weeks(grouped, monday)
        weeks = []
        for i, each in enumerate(mondays):
            older = week_of(mondays[i - 1]) if i else None
            newer = week_of(mondays[i + 1]) if i + 1 < len(mondays) else None
            # A file with one week in it has nowhere to go, so it gets no arrows.
            nav = board_nav(older, newer) if len(mondays) > 1 else ""
            weeks.append(drawn_week(grouped.get(each, []), each, rules["report"], nav, each == monday))
    page = render_board(weeks, title)
    out = Path(args.out).expanduser() if args.out else STATE / "board.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(page)
    print(out)
    if not args.no_open:
        # `open` reports a browser it could not start as an exit status and not
        # as an exception, so the status is read too. Either way the board is
        # already written and its path is already printed, so the failure is
        # worth one line on stderr and nothing more.
        try:
            failed = subprocess.run(["open", str(out)], timeout=10, check=False).returncode != 0
        except (OSError, subprocess.TimeoutExpired):
            failed = True
        if failed:
            print("could not open it; the line above is where it is", file=sys.stderr)
    return 0


def git_remote(cwd: str):
    try:
        done = subprocess.run(
            ["git", "-C", cwd, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=2
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() or None


def write_note(path: Path, note: dict) -> dict:
    """Written whole, then renamed, so the Spoon never reads half a file. The
    temporary carries the writer's process id: hooks run concurrently, and two
    of them sharing one temporary would have the first one renamed away under
    the second, which then loses its note to an error."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / f"{path.name}.{os.getpid()}.tmp"
    temporary.write_text(json.dumps(note))
    temporary.replace(path)
    return note


@contextlib.contextmanager
def locked(path: Path):
    """One session's hooks can land at once: a prompt while a task the model
    left running in the background reports a tool it used. Both would read the
    note, both would write it back, and the later one would erase what the other
    had just learnt. The lock is a file of its own, so the note itself stays one
    atomic rename and the Spoon never has to take a lock to read it. It is never
    deleted: a lock nobody can unlink from under a holder is one less race."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = os.open(str(path), os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield
    finally:
        os.close(handle)  # which releases the lock


def read_note(path: Path) -> dict:
    try:
        note = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return note if isinstance(note, dict) else {}


def terminal_pane():
    """Which pane of a terminal this process was started in, or None when the
    terminal does not say. iTerm2 puts an id for the session into the
    environment of every shell it opens, and everything started in that shell
    inherits it, Claude Code and its hooks included: `w0t3p0:<uuid>`, where the
    part before the colon moves when a tab is dragged and the part after it
    belongs to that pane for as long as it is open. iTerm2 sets both names;
    Terminal sets the second. The Spoon asks the terminal in front which pane is
    selected, so the chat somebody is reading is known rather than guessed
    ([ADR 0012](../docs/adr/0012-the-pane-in-front-is-the-chat.md))."""
    for name in ("ITERM_SESSION_ID", "TERM_SESSION_ID"):
        pane = (os.environ.get(name) or "").rsplit(":", 1)[-1].strip()
        if pane:
            return pane
    return None


def write_context(
    source: str, cwd: str, state=None, name: str = "context", session=None, remote=UNKNOWN, at=None
) -> dict:
    """Leave a note for the Spoon: which directory a tool is working in, and
    which remote that belongs to."""
    state = state or STATE
    return write_note(
        (state / f"{name}.json"),
        {
            "at": int(time.time()) if at is None else at,
            "source": source,
            "cwd": cwd,
            "remote": git_remote(cwd) if remote is UNKNOWN else remote,
            # macOS sets this for every process an application starts, so the
            # hook knows which editor or terminal is hosting the session. The
            # Spoon applies the note to that application's windows and to no
            # other's.
            "bundle": os.environ.get("__CFBundleIdentifier"),
            "pane": terminal_pane(),
            "session": session,
        },
    )


def prune_sessions(directory: Path, now: float) -> None:
    try:
        entries = list(directory.iterdir())
    except OSError:
        return
    for entry in entries:
        # The lock stays. It is empty, there is one of it, and unlinking a lock
        # while a hook holds it would let the next two merges run at once: the
        # one holding the gone inode and the one that made a fresh file.
        if entry.name == SESSION_LOCK:
            continue
        try:
            if now - entry.stat().st_mtime > SESSION_TTL:
                entry.unlink()
        except OSError:
            continue


def one_line(text, limit: int = TITLE_MAX) -> str:
    """Whitespace collapsed and the end cut off, because this goes into one row
    of a panel the width of a repository name."""
    cut = " ".join(str(text).split())
    if len(cut) <= limit:
        return cut
    return cut[: limit - 1].rstrip() + "\u2026"


# What can name a chat, in the order it counts: a name the person typed in
# themselves is the name they read in their own list, whatever the tool has
# called the conversation since, and failing both the last thing typed into it
# says which chat this is as well as anything.
TITLE_KINDS = (("custom-title", "customTitle"), ("ai-title", "aiTitle"), ("last-prompt", "lastPrompt"))


def chat_title(transcript) -> str:
    """The name a chat goes by, for the list the Spoon offers when it has to ask
    which one somebody is in. Claude Code writes a `custom-title` entry when the
    chat has been renamed by hand and an `ai-title` entry otherwise, rewriting
    the latter as the conversation moves on, and one of those is the title the
    person reads in their own chat list. Empty when the file names it in no way
    at all, and then the Spoon falls back to the repository.

    Only the end of the file is read. The entry is rewritten on every exchange,
    so that is where the current one is, and a long conversation is a large file
    to read on every prompt."""
    if not isinstance(transcript, str) or not transcript:
        return ""
    try:
        with open(transcript, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - TRANSCRIPT_TAIL))
            tail = handle.read().decode("utf-8", "replace")
    except OSError:
        return ""
    found = {}
    # Backwards, because the newest entry of a kind is the one that counts. A
    # line that will not decode is passed over: the first line of the slice is
    # half a line whenever the file is longer than the slice, and the last can
    # be half of one when the file is being written while it is read.
    for line in reversed(tail.splitlines()):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if not isinstance(entry, dict):
            continue
        for kind, key in TITLE_KINDS:
            named = entry.get(key)
            if entry.get("type") == kind and key not in found and isinstance(named, str) and named.strip():
                found[key] = one_line(named)
        if "customTitle" in found:
            # Nothing outranks the name they gave it themselves.
            break
    for _, key in TITLE_KINDS:
        if key in found:
            return found[key]
    return ""


def write_session(source: str, cwd: str, session, prompt: bool, remote=UNKNOWN, state=None, at=None, title=""):
    """One note per chat session, so that several sessions running in the same
    editor can be told apart.

    The note remembers the last repository this session actually touched. A
    session started in a folder full of checkouts resolves to nothing by its
    working directory, and a prompt carries no file to go on, so without that
    memory the chat the person is typing into would be the one thing about them
    nobody knows. `title` is what the chat calls itself, so that a list of them
    names conversations rather than checkouts. `promptAt` is when they last
    talked to it, to the second, and `promptOrder` the same to the microsecond; a session that has
    only ever worked is no chat and the Spoon skips it. The note also names the
    terminal pane the session was opened in, which is how four chats in four tabs
    are told apart with nobody asked anything."""
    state = state or STATE
    if not isinstance(session, str) or not SESSION_NAME.match(session):
        return None
    directory = state / "sessions"
    path = directory / f"{session}.json"
    # The whole second is what the Spoon reads and what everything is dated by.
    # Two hooks of one session can fall in the same second, though, and then the
    # second cannot say which of them happened first: `order` is the same moment
    # to the microsecond, and nothing but the merge below looks at it.
    moment = time.time() if at is None else float(at)
    now = int(moment)
    # Asked before the lock is taken. Git can sit out its whole timeout, and no
    # other session's merge should have to wait behind that.
    found = git_remote(cwd) if remote is UNKNOWN else remote
    with locked(directory / SESSION_LOCK):
        before = read_note(path)
        # Hooks reach the lock in whatever order the machine felt like, and one
        # that waited on git can arrive behind a later event of its own session.
        # So the merge decides and not the arrival: where the session is comes
        # from the newest event to have written, an older one only fills in what
        # the note does not say yet, and no timestamp goes backwards. A note
        # written before there was an `order` is dated by its second.
        sequence = before.get("order") or before.get("at") or 0
        newer = moment >= sequence
        remembered = before.get("remote")
        note = write_note(
            path,
            {
                "at": max(now, before.get("at") or 0),
                "order": max(moment, sequence),
                "promptAt": max(now if prompt else 0, before.get("promptAt") or 0) or None,
                # The same second holds a prompt and an answer given to the
                # Spoon's panel, and which came first decides whether that
                # answer still stands. The second cannot say, so the moment is
                # written down as well.
                "promptOrder": max(moment if prompt else 0, before.get("promptOrder") or 0) or None,
                # The title follows the prompt and not the event, because a
                # tool event knows nothing about what the chat is called. A
                # prompt that waited on git can reach the lock behind a tool
                # event of its own session and still be the newest prompt there
                # is, which is the one this title belongs to. Once found, a title
                # is kept until a newer prompt brings another.
                "title": (one_line(title) if prompt and title and now >= (before.get("promptAt") or 0) else "")
                or before.get("title"),
                "source": source if newer else before.get("source"),
                "cwd": cwd if newer else before.get("cwd"),
                "remote": (found or remembered) if newer else (remembered or found),
                "bundle": os.environ.get("__CFBundleIdentifier") or before.get("bundle"),
                # A pane is where the session was opened and it does not move, so
                # the note keeps the one it knows rather than dropping it for an
                # event that came from somewhere with nothing to say about panes.
                "pane": terminal_pane() or before.get("pane"),
                "session": session,
            },
        )
        # Under the same lock: a note this hook found stale can be written again
        # by the session that owns it while the prune is still walking, and
        # deleting it then would lose a live chat until it was next spoken to.
        prune_sessions(directory, now)
    return note


# ---------------------------------------------------------------------------
# The calendar


def keychain(account: str, secret=None):
    """The refresh token, in the login keychain. Reading it is what lets the
    tracker ask Graph again tomorrow without another sign-in; writing it is the
    only thing the sign-in leaves behind.

    The token goes to `security` on its command line, where another process on
    this machine could see it for as long as the call takes. A file in the state
    directory would be readable for as long as it exists, which is longer."""
    if secret is None:
        found = subprocess.run(
            ["security", "find-generic-password", "-a", account, "-s", KEYCHAIN_SERVICE, "-w"],
            capture_output=True,
            text=True,
            check=False,
        )
        return found.stdout.strip() if found.returncode == 0 else None
    subprocess.run(
        ["security", "add-generic-password", "-U", "-a", account, "-s", KEYCHAIN_SERVICE, "-w", secret],
        capture_output=True,
        check=True,
    )
    return secret


def meeting_settings(rules: dict) -> dict:
    """The `meetings` block, checked. A tenant and a client id are what turn the
    calendar on; without them there is nothing to sign in to."""
    settings = rules["meetings"]
    if not settings.get("enabled"):
        raise SystemExit("meetings.enabled is false in the rules file: the calendar is not being read.")
    for key in ("tenantId", "clientId"):
        if not settings.get(key):
            raise SystemExit(f"meetings.{key} is not set in the rules file.")
    return settings


def graph_token(settings: dict) -> str:
    """An access token for Graph, from the refresh token the sign-in left in the
    keychain. Access tokens last an hour and are not kept: one round trip per
    run is cheaper than a stale token on disk."""
    account = settings["clientId"]
    refresh = keychain(account)
    if not refresh:
        raise SystemExit("no sign-in yet: run `zyt login` once.")
    answer = _token_request(
        settings,
        {
            "client_id": settings["clientId"],
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "scope": GRAPH_SCOPES,
        },
    )
    # Entra hands out a new refresh token on every use and expires the old one
    # after a while. Keeping the newest is what stops the sign-in from lapsing.
    if answer.get("refresh_token"):
        keychain(account, answer["refresh_token"])
    return answer["access_token"]


def _token_request(settings: dict, form: dict) -> dict:
    url = f"https://login.microsoftonline.com/{settings['tenantId']}/oauth2/v2.0/token"
    data = urllib.parse.urlencode(form).encode()
    request = urllib.request.Request(url, data=data, headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(request, timeout=30) as answer:
            return json.loads(answer.read())
    except urllib.error.HTTPError as error:
        detail = json.loads(error.read() or b"{}")
        raise SystemExit(
            "Entra refused the token: {} {}".format(
                detail.get("error", error.code), (detail.get("error_description") or "").split(chr(10))[0]
            )
        ) from None


def sign_in(settings: dict) -> None:
    """The one interactive sign-in. A public client with no secret proves it
    asked for the code it is redeeming with PKCE, and the code comes back to a
    server on this machine, so it never leaves it."""
    verifier = base64.urlsafe_b64encode(os.urandom(32)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = base64.urlsafe_b64encode(os.urandom(16)).rstrip(b"=").decode()
    redirect = settings["redirectUri"]
    port = urllib.parse.urlparse(redirect).port or 80
    query = urllib.parse.urlencode(
        {
            "client_id": settings["clientId"],
            "response_type": "code",
            "redirect_uri": redirect,
            "response_mode": "query",
            "scope": GRAPH_SCOPES,
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
        }
    )
    url = f"https://login.microsoftonline.com/{settings['tenantId']}/oauth2/v2.0/authorize?{query}"
    caught = {}

    class Catcher(http.server.BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802 - the name is http.server's
            answered = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            # The browser asks for the favicon of the page it was just shown,
            # and anything else on this machine may knock on the port as well.
            # Only what carries the answer is the answer.
            if "code" in answered or "error" in answered:
                caught.update(answered)
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(b"<html><body><p>zyt has the sign-in. This tab can be closed.</p></body></html>")

        def log_message(self, *_args):
            pass

    with http.server.HTTPServer(("127.0.0.1", port), Catcher) as server:
        # Each wait is short and the deadline is the long one, so a knock on the
        # port costs a moment rather than the sign-in.
        server.timeout = 1
        deadline = time.time() + SIGN_IN_SECONDS
        print(f"Sign in as the reader the app is assigned to:\n{url}")
        subprocess.run(["open", url], check=False)
        while not caught and time.time() < deadline:
            server.handle_request()
    if not caught:
        raise SystemExit("the sign-in did not come back within five minutes: nothing was stored.")
    if "error" in caught:
        raise SystemExit("the sign-in came back without a code: {}".format(caught["error"][0]))
    if caught.get("state", [None])[0] != state:
        raise SystemExit("the sign-in came back with another state: nothing was stored.")
    answer = _token_request(
        settings,
        {
            "client_id": settings["clientId"],
            "grant_type": "authorization_code",
            "code": caught["code"][0],
            "redirect_uri": redirect,
            "code_verifier": verifier,
            "scope": GRAPH_SCOPES,
        },
    )
    keychain(settings["clientId"], answer["refresh_token"])


def calendar_view(settings: dict, start: float, end: float, token=None) -> list:
    """The events between two moments, as epoch seconds. `calendarView` is the
    one that matters: it expands a recurring series into the occurrences that
    actually fall in the window, which the series itself does not say.

    Start, end, all-day flag, busy status and the answer given are all it asks
    for. A subject would say what the meeting is about, and the tracker only
    needs to know that there was one."""
    token = token or graph_token(settings)
    query = urllib.parse.urlencode(
        {
            "startDateTime": _utc(start),
            "endDateTime": _utc(end),
            "$select": "start,end,isAllDay,showAs,responseStatus,isCancelled",
            "$top": "200",
            "$orderby": "start/dateTime",
        }
    )
    url = f"{GRAPH}/me/calendarView?{query}"
    out = []
    # A page at a time, because a window of a few days can hold more events than
    # one holds, and Graph says so in `@odata.nextLink` rather than by failing.
    # The header pins the answer to UTC, which is what the times are read as.
    while url:
        request = urllib.request.Request(
            url,
            headers={"Authorization": f"Bearer {token}", "Prefer": 'outlook.timezone="UTC"'},
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as answer:
                body = json.loads(answer.read())
        except urllib.error.HTTPError as error:
            detail = json.loads(error.read() or b"{}").get("error", {})
            raise SystemExit(
                f"Graph refused the calendar: {error.code} {detail.get('code', '')} {detail.get('message', '')}"
            ) from None
        for event in body.get("value", []):
            out.append(
                {
                    "start": _epoch(event.get("start")),
                    "end": _epoch(event.get("end")),
                    "allDay": bool(event.get("isAllDay")),
                    "cancelled": bool(event.get("isCancelled")),
                    "status": event.get("showAs"),
                    "response": (event.get("responseStatus") or {}).get("response"),
                }
            )
        url = body.get("@odata.nextLink")
    return [event for event in out if event["start"] and event["end"]]


def _utc(moment: float) -> str:
    return dt.datetime.fromtimestamp(moment, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _epoch(stamp) -> float:
    """Graph dates are `2026-09-30T13:00:00.0000000` with a time zone beside
    them, and UTC unless something asked for another one. Python before 3.11
    cannot parse seven fractional digits, so the fraction goes."""
    if not isinstance(stamp, dict) or not isinstance(stamp.get("dateTime"), str):
        return 0
    text = stamp["dateTime"].split(".")[0]
    zone = stamp.get("timeZone") or "UTC"
    try:
        when = dt.datetime.strptime(text, "%Y-%m-%dT%H:%M:%S")
    except ValueError:
        return 0
    if zone.upper() == "UTC":
        return when.replace(tzinfo=dt.timezone.utc).timestamp()
    # The request asks for UTC and that is what standard events come back in,
    # but an all-day event or a calendar of its own can answer in another zone.
    # One of those must not take the rest of the day's events with it.
    try:
        return when.replace(tzinfo=zoneinfo.ZoneInfo(zone)).timestamp()
    except (zoneinfo.ZoneInfoNotFoundError, ValueError):
        # Graph names zones the Windows way unless it is asked for the other
        # kind, and this machine knows only the other kind.
        print(f"zyt: an event came back in {zone}, which is no zone here; it is left out", file=sys.stderr)
        return 0


def cmd_login(_args) -> int:
    settings = meeting_settings(load_rules())
    sign_in(settings)
    print("signed in; the refresh token is in the login keychain.")
    return 0


def cmd_fill(args) -> int:
    """Catch the record up with the calendar: every gap in the last `--days`
    that a meeting covered gets its rows. The Spoon does the writing, because
    it owns that file; this reads the calendar and hands the events over."""
    settings = meeting_settings(load_rules())
    now = time.time()
    since = now - float(args.days) * 86400
    events = calendar_view(settings, since, now)
    payload = json.dumps({"from": since, "to": now, "events": events})
    # A long bracket, because the payload is JSON and holds quotes; `]==]`
    # cannot appear in it.
    answer = hs_call(f"return _G.zyt and tostring(_G.zyt:fillGaps([==[{payload}]==])) or 'null'", timeout=30)
    if not answer or answer == "null":
        print("zyt is not running in Hammerspoon (try: zyt doctor)")
        return 1
    try:
        seconds = int(float(answer))
    except ValueError:
        print(f"the Spoon answered {answer!r}")
        return 1
    if seconds < 0:
        print("the Spoon could not read what it was handed")
        return 1
    print(f"filled {seconds // 3600}h{seconds % 3600 // 60:02d} of meetings from the last {args.days:g} days")
    return 0


def cmd_meetings(args) -> int:
    settings = meeting_settings(load_rules())
    now = time.time()
    since = now - float(args.hours) * 3600
    events = calendar_view(settings, since, now + 3600)
    if args.json:
        print(json.dumps({"events": events}))
        return 0
    if not events:
        print("no events in that window")
        return 0
    for event in events:
        print(
            "{}  {}  {:>5}  {}".format(
                dt.datetime.fromtimestamp(event["start"]).strftime("%a %d.%m. %H:%M"),
                dt.datetime.fromtimestamp(event["end"]).strftime("%H:%M"),
                event["status"] or "?",
                "cancelled" if event["cancelled"] else (event["response"] or ""),
            )
        )
    return 0


def hook_directory(payload) -> str:
    """The directory a hook event is about: the file the tool touched when
    there is one, since a session started in a folder full of checkouts says
    nothing by its working directory alone; otherwise that working directory."""
    if not isinstance(payload, dict):
        return os.getcwd()
    tool_input = payload.get("tool_input")
    if isinstance(tool_input, dict):
        for key in ("file_path", "notebook_path"):
            path = tool_input.get(key)
            if isinstance(path, str) and path:
                where = Path(path)
                if not where.is_dir():
                    where = where.parent
                while not where.exists() and where != where.parent:
                    where = where.parent
                return str(where)
    return payload.get("cwd") or os.getcwd()


def cmd_hook(args) -> int:
    """For Claude Code: `zyt hook claude-code` on UserPromptSubmit and
    PostToolUse. Reads the hook's JSON, writes the note, says nothing: anything
    printed here would be handed to the model as context."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    where = hook_directory(payload)
    session = payload.get("session_id") if isinstance(payload, dict) else None
    prompt = isinstance(payload, dict) and payload.get("hook_event_name") == "UserPromptSubmit"
    remote = git_remote(where)
    # One event, one timestamp, however long the git call takes: the Spoon tells
    # the notes of the same prompt apart from an older chat's by comparing them.
    # The fraction is kept, because the Spoon puts a prompt and an answer of the
    # same second in order by it; the notes that are dated by the second round
    # it off themselves.
    moment = time.time()
    # The session's own note knows more than this one event does: the remote it
    # last touched, even when the event itself is a prompt in a folder that is
    # no checkout.
    # Read on a prompt and not on a tool event: the title only moves when the
    # person says something, and a tool event is the common one by far.
    title = chat_title(payload.get("transcript_path")) if prompt else ""
    note = write_session(args.tool, where, session, prompt, remote=remote, at=moment, title=title)
    if note:
        remote = note["remote"]
    write_context(args.tool, where, session=session, remote=remote, at=int(moment))
    # A prompt is the person talking to this chat. Several sessions can be
    # working at once, and only one of them is the one being typed into; the
    # Spoon uses this second note to classify the editor's window.
    if prompt:
        write_context(args.tool, where, name="chat", session=session, remote=remote, at=int(moment))
    return 0


def cmd_context(args) -> int:
    note = write_context(args.source, str(Path(args.cwd).resolve()))
    print(json.dumps(note))
    return 0


def cmd_doctor(_args) -> int:
    failed = False

    def say(ok, text):
        nonlocal failed
        failed = failed or ok is False
        mark = {True: " ok ", False: "FAIL", None: "warn"}[ok]
        print(f"[{mark}] {text}")

    say(Path("/Applications/Hammerspoon.app").exists(), "Hammerspoon is installed")
    running = hammerspoon_running()
    say(running, "Hammerspoon is running" if running else "Hammerspoon is not running")
    up = running and hs_call("return 'up'") == "up"
    if running:
        say(up, "Hammerspoon answers over ipc" if up else "Hammerspoon does not answer over ipc (is hs.ipc loaded?)")
    if up:
        say(
            hs_call("return tostring(hs.accessibilityState())") == "true",
            "Hammerspoon has Accessibility (window titles need it)",
        )
        spoon_up = hs_call("return tostring(_G.zyt and _G.zyt.running)") == "true"
        say(
            spoon_up, "the Spoon is running" if spoon_up else f"the Spoon is not running: is `{LOAD_LINE}` in init.lua?"
        )
        if spoon_up:
            age = hs_call("return tostring(_G.zyt.state.open and (os.time() - _G.zyt.state.open.lastSeen) or 'closed')")
            if age is None or not age.lstrip("-").isdigit() and age != "closed":
                say(False, f"could not read the last tick from the Spoon: {age}")
            elif age == "closed":
                say(None, "no segment is open right now (away, or the rules see nothing)")
            else:
                say(int(age) < 120, f"the last tick was {age}s ago")
            frame = hs_call("local m = _G.zyt.menubar; if not m then return 'none' end return tostring(m:frame().x)")
            if frame not in (None, "none") and float(frame) < 0:
                say(None, "the menu-bar item is parked off-screen, probably by a menu bar manager")
    link = SPOONS / "Zyt.spoon"
    say(link.exists(), f"{link} exists" if link.exists() else f"{link} is missing (zyt link)")
    pane = terminal_pane()
    # Writing the pane down and matching it are two things. Terminal names its
    # panes as well, but the Spoon can only ask iTerm2 which of its panes is in
    # front, so anywhere else the id sits in the note without being used.
    if pane and os.environ.get("TERM_PROGRAM") == "iTerm.app":
        say(True, f"this terminal names its panes ({pane}): a chat started here is matched to the pane in front")
    elif pane:
        say(None, f"the pane is noted ({pane}), but the Spoon cannot ask this terminal which pane is in front")
    else:
        say(None, "this terminal does not name its panes; chats started here are told apart by what they work on")
    try:
        rules = load_rules()
        say(True, f"rules file read: {CONFIG}" if CONFIG.exists() else f"no rules file at {CONFIG}, defaults apply")
        say(capacity(rules["report"]) > 0, f"a workday can hold {fmt_m(capacity(rules['report']))}")
    except (ValueError, SystemExit) as error:
        say(False, f"rules file: {error}")
    rows = read_intervals(STATE / "intervals.csv")
    say(
        True,
        f"{len(rows)} rows in {STATE / 'intervals.csv'}"
        + (f", last ended {rows[-1].end:%d.%m. %H:%M}" if rows else ""),
    )
    return 1 if failed else 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="zyt", description=__doc__.split("\n\n")[1])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("link", help="symlink the Spoon into ~/.hammerspoon/Spoons").set_defaults(run=cmd_link)
    sub.add_parser("unlink", help="remove that symlink").set_defaults(run=cmd_unlink)
    sub.add_parser("status", help="what is running now").set_defaults(run=cmd_status)
    for name in ("work", "private", "auto"):
        sub.add_parser(
            name, help=f"pin the class to {name}" if name != "auto" else "let the rules decide"
        ).set_defaults(run=cmd_switch)
    for name, when in (("day", "YYYY-MM-DD"), ("week", "YYYY-Www")):
        report = sub.add_parser(name, help=f"the recorded {name} and its booking proposal")
        report.add_argument("when", nargs="?", metavar=when)
        report.add_argument("--json", action="store_true")
        report.set_defaults(run=cmd_report)
    board = sub.add_parser("board", help="the same week or day as one HTML file, and open it")
    board.add_argument("when", nargs="?", metavar="YYYY-Www|YYYY-MM-DD")
    board.add_argument("--out", metavar="FILE", help=f"where to write it, default {STATE / 'board.html'}")
    board.add_argument("--no-open", action="store_true", help="write it and leave it closed")
    board.add_argument("--one-week", action="store_true", help="that week alone, with no way back to the others")
    board.set_defaults(run=cmd_board)
    hook = sub.add_parser("hook", help="stdin hook for a coding tool (Claude Code)")
    hook.add_argument("tool", choices=["claude-code"])
    hook.set_defaults(run=cmd_hook)
    context = sub.add_parser("context", help="note which directory a tool is working in")
    context.add_argument("source")
    context.add_argument("cwd", nargs="?", default=".")
    context.set_defaults(run=cmd_context)
    sub.add_parser("login", help="sign in to Microsoft Graph once, for the calendar").set_defaults(run=cmd_login)
    meetings = sub.add_parser("meetings", help="the calendar events zyt can see")
    meetings.add_argument("--hours", type=float, default=24, help="how far back to look (default 24)")
    meetings.add_argument("--json", action="store_true", help="print them as JSON, for the Spoon")
    meetings.set_defaults(run=cmd_meetings)
    fill = sub.add_parser("fill", help="write the meetings of past gaps into the record")
    fill.add_argument("--days", type=float, default=7, help="how far back to look (default 7)")
    fill.set_defaults(run=cmd_fill)
    sub.add_parser("doctor", help="check the installation").set_defaults(run=cmd_doctor)
    args = parser.parse_args(argv)
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
